#version 460
// TEMPORARY: stage 3 proof. Delete together with src/gradient.rs.
// Reads the small gradient image through a sampler and writes it to the output image.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_SAMPLED_IMAGES) uniform texture2D textures[];
layout(set = BINDLESS_SET, binding = BINDLESS_SAMPLERS) uniform sampler samplers[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform writeonly image2D images[];

// Must agree with `draw` in src/gradient.rs.
layout(push_constant) uniform Push {
    uint src;         // index in `textures`
    uint src_sampler; // index in `samplers`
    uint dst;         // index in `images`
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    // A compute shader has no automatic mip level, so the level is explicit.
    vec4 color = textureLod(sampler2D(textures[push.src], samplers[push.src_sampler]), uv, 0.0);
    imageStore(images[push.dst], pixel, color);
}
