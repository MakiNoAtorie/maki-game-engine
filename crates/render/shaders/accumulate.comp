#version 460
// Pass "accumulate": keeps the mean of the `radiance` images of all frames since the
// last reset, in the `accumulated` image.
//
// One frame of the path tracer is noisy: each pixel holds one random sample. The mean
// of N samples has less noise (it falls with the square root of N), so the picture
// gets clean while nothing changes.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// No `readonly` or `writeonly`: the pass reads one image and reads and writes the other.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba32f)
    uniform image2D images[];

// Must agree with `Accumulate::execute` in src/passes.rs.
layout(push_constant) uniform Push {
    uint radiance;    // index in `images`: the sample of this frame
    uint accumulated; // index in `images`: the mean
    uint samples;     // number of samples in the mean, with this one. 1 starts a new mean.
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images[push.accumulated]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec3 radiance = imageLoad(images[push.radiance], pixel).rgb;
    // A value that is not a number would stay in the mean until the next reset.
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    vec3 mean = radiance;
    // The first sample replaces the old content, which is undefined in a new image.
    if (push.samples > 1) {
        // The mean of N values from the mean of N - 1: move 1/N of the way to the new value.
        vec3 old = imageLoad(images[push.accumulated], pixel).rgb;
        mean = old + (radiance - old) / float(push.samples);
    }
    imageStore(images[push.accumulated], pixel, vec4(mean, 1.0));
}
