#version 460
// Pass "denoise_temporal": the mean over time. See src/denoise.rs for the full method.
//
// The trace pass gives three kinds of light for each pixel (see trace.comp): `direct`
// and `indirect` without the surface color, and `specular`. For each pixel:
// 1. The `motion` image tells where the point of the pixel was on the screen one
//    frame before. The history of the pixel is read there, from the images of the
//    frame before: the mean of each kind of light, the number of samples, the moments.
//    The place is between four pixels. Each of the four counts only if it showed the
//    same surface (normal and distance): at the edge of a moving object, the others
//    show the object or what was behind it.
// 2. The new mean is the old mean moved toward the samples of this frame by
//    `samples of this frame / samples in the new mean`. With no history that is 1: the
//    pixel starts again, alone.
//
// Written, for the next passes and as the history of the next frame:
// - direct:   rgb: the mean direct light. a: the number of samples in the means.
// - indirect: rgb: the mean indirect light.
// - specular: rgb: the mean specular light.
// - moments:  for the direct light in r and g, for the indirect light in b and a: the
//             mean brightness of one frame, and the mean of its square. The difference
//             `g - r * r` is the variance: how noisy one frame is here.
// A pixel with no surface (the background, the light itself) has no history: its
// means are zero, and so is its sample count.
// The emission (the fourth channels of the three input images) does not go through
// this pass: `denoise_resolve` reads it.

#include "bindless.glsl"
#include "denoise.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The same binding, seen with the formats of the images.
// No `readonly` or `writeonly`: the pass reads the history and writes the new mean.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba32f)
    uniform image2D images_rgba32f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform image2D images_rgba16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rg16f)
    uniform readonly image2D images_rg16f[];

// Must agree with `DenoiseTemporal::execute` in src/denoise.rs.
layout(push_constant) uniform Push {
    // The samples of this frame, indices in `images_rgba16f`.
    uint direct;
    uint indirect;
    uint specular;
    uint normal;            // index in `images_rgba16f`: normal in xyz (zero: no surface), distance in w
    uint previous_normal;   // the same image of the frame before
    uint motion;            // index in `images_rg16f`: screen motion in pixels
    // The means of the frame before, and those that this pass writes.
    uint previous_direct;   // index in `images_rgba32f`
    uint previous_indirect; // index in `images_rgba32f`
    uint previous_moments;  // index in `images_rgba32f`
    uint previous_specular; // index in `images_rgba16f`
    uint mean_direct;       // index in `images_rgba32f`
    uint mean_indirect;     // index in `images_rgba32f`
    uint moments;           // index in `images_rgba32f`
    uint mean_specular;     // index in `images_rgba16f`
    float frame_samples;    // samples in the images of this frame, 1 or more
    // The history of a pixel counts as this many samples at most. 0: no history is
    // read (the first frame, a new image size). A low limit after a change of the
    // lighting: the old light then fades in few frames.
    float history_limit;
    float max_samples;      // the mean never counts as more samples than this
} push;

// A pixel of the frame before shows the same surface if the cosine of the angle
// between the two normals is not below this, ...
const float SAME_NORMAL = 0.9;
// ... and the two distances from the camera differ by less than this part.
const float SAME_DISTANCE = 0.03;
// A motion below this, in pixels, counts as none. A point at rest then reads its own
// pixel and nothing of the pixels around it: rounding errors in the motion would blur
// the picture a little in each frame.
const float NO_MOTION = 0.01;

// The light of this frame. A value that is not a number would stay in the mean.
vec3 sample_of(uint image, ivec2 pixel) {
    vec3 light = imageLoad(images_rgba16f[image], pixel).rgb;
    return any(isnan(light)) || any(isinf(light)) ? vec3(0.0) : light;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba32f[push.mean_direct]);
    // The work groups cover full 8x8 blocks, so some invocations are out of the image.
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec3 direct = sample_of(push.direct, pixel);
    vec3 indirect = sample_of(push.indirect, pixel);
    vec3 specular = sample_of(push.specular, pixel);
    vec4 surface = imageLoad(images_rgba16f[push.normal], pixel);
    if (surface.xyz == vec3(0.0)) {
        imageStore(images_rgba32f[push.mean_direct], pixel, vec4(0.0));
        imageStore(images_rgba32f[push.mean_indirect], pixel, vec4(0.0));
        imageStore(images_rgba32f[push.moments], pixel, vec4(0.0));
        imageStore(images_rgba16f[push.mean_specular], pixel, vec4(0.0));
        return;
    }
    vec2 values = vec2(brightness(direct), brightness(indirect));

    // The history: a blend of up to four pixels of the frame before.
    vec4 old_direct = vec4(0.0);
    vec3 old_indirect = vec3(0.0);
    vec3 old_specular = vec3(0.0);
    vec4 old_moments = vec4(0.0);
    float weights = 0.0;
    if (push.history_limit > 0.0) {
        vec2 motion = imageLoad(images_rg16f[push.motion], pixel).xy;
        if (all(lessThan(abs(motion), vec2(NO_MOTION)))) {
            motion = vec2(0.0);
        }
        // Where the point was, in pixel units with pixel centers at whole numbers.
        vec2 was = vec2(pixel) - motion;
        ivec2 corner = ivec2(floor(was));
        vec2 part = was - vec2(corner);
        for (int y = 0; y <= 1; y++) {
            for (int x = 0; x <= 1; x++) {
                ivec2 tap = corner + ivec2(x, y);
                float weight = (x == 0 ? 1.0 - part.x : part.x) * (y == 0 ? 1.0 - part.y : part.y);
                if (weight == 0.0 || any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, size))) {
                    continue;
                }
                vec4 tap_surface = imageLoad(images_rgba16f[push.previous_normal], tap);
                if (dot(tap_surface.xyz, surface.xyz) < SAME_NORMAL
                    || abs(tap_surface.w - surface.w) > SAME_DISTANCE * surface.w) {
                    continue;
                }
                old_direct += weight * imageLoad(images_rgba32f[push.previous_direct], tap);
                old_indirect += weight * imageLoad(images_rgba32f[push.previous_indirect], tap).rgb;
                old_specular += weight * imageLoad(images_rgba16f[push.previous_specular], tap).rgb;
                old_moments += weight * imageLoad(images_rgba32f[push.previous_moments], tap);
                weights += weight;
            }
        }
    }
    float old_samples = 0.0;
    // A history from a small part of the four pixels is not used: it is mostly noise.
    if (weights > 0.1) {
        old_direct /= weights;
        old_indirect /= weights;
        old_specular /= weights;
        old_moments /= weights;
        old_samples = min(old_direct.a, push.history_limit);
    }
    // The mean of N values from the mean of N - k and the mean of the k new ones:
    // move k/N of the way to the new value. At the sample limit N stays the same, and
    // each frame still replaces k/N of the mean.
    float samples = min(old_samples + push.frame_samples, push.max_samples);
    float step_to_new = push.frame_samples / samples;
    vec4 new_moments = vec4(values.x, values.x * values.x, values.y, values.y * values.y);
    imageStore(images_rgba32f[push.mean_direct], pixel,
        vec4(mix(old_direct.rgb, direct, step_to_new), samples));
    imageStore(images_rgba32f[push.mean_indirect], pixel,
        vec4(mix(old_indirect, indirect, step_to_new), 0.0));
    imageStore(images_rgba16f[push.mean_specular], pixel,
        vec4(mix(old_specular, specular, step_to_new), 0.0));
    imageStore(images_rgba32f[push.moments], pixel, mix(old_moments, new_moments, step_to_new));
}
