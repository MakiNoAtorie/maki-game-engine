#version 460
// Pass "denoise_prepare": the input of the filter passes. See src/denoise.rs for the
// full method.
//
// Reads the mean of the temporal pass and writes, for each pixel:
// - rgb: the mean light (without the surface color), in a 16-bit image.
// - a: the variance of that mean: how much noise is left in it. The filter passes blur
//   more where this is large. Two measures:
//   1. Over time: the moments give the variance of one frame, and the mean of N frames
//      has 1/N of it. Exact for the pixel, but it needs some frames.
//   2. Over space: the variance of the mean in the 3x3 block around the pixel. It
//      works from the first frame, but it also takes each edge of the light (a shadow
//      edge, a contact shadow) for noise: with it the filter never turns off there.
//   So, as in SVGF: the larger one of the two while the mean has fewer than
//   `SPATIAL_FRAMES` frames, then the measure over time alone.
// A pixel with no surface (the background, the light itself) is copied as it is.

#include "bindless.glsl"
#include "denoise.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The same binding, seen with the formats of the images.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba32f)
    uniform readonly image2D images_rgba32f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform image2D images_rgba16f[];

// Must agree with `DenoisePrepare::execute` in src/denoise.rs.
layout(push_constant) uniform Push {
    uint color;          // index in `images_rgba32f`: mean light in rgb, samples in a
    uint moments;        // index in `images_rgba32f`: mean brightness and mean of its square
    uint normal;         // index in `images_rgba16f`: surface normal in xyz, zero for no surface
    uint dst;            // index in `images_rgba16f`
    float frame_samples; // samples that one frame adds to the mean
} push;

// The measure over space counts while the mean has fewer frames than this.
const float SPATIAL_FRAMES = 4.0;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec4 center = imageLoad(images_rgba32f[push.color], pixel);
    vec3 light = min(center.rgb, vec3(MAX_LIGHT));
    vec3 normal = imageLoad(images_rgba16f[push.normal], pixel).xyz;
    if (normal == vec3(0.0)) {
        imageStore(images_rgba16f[push.dst], pixel, vec4(light, 0.0));
        return;
    }
    // Over time. Zero for a history of one frame.
    float frames = max(1.0, center.a / push.frame_samples);
    vec2 moments = imageLoad(images_rgba32f[push.moments], pixel).xy;
    float over_time = max(0.0, moments.y - moments.x * moments.x) / frames;
    if (frames >= SPATIAL_FRAMES) {
        imageStore(images_rgba16f[push.dst], pixel, vec4(light, min(over_time, MAX_LIGHT)));
        return;
    }

    // Over space: mean and mean of squares of the brightness, over the pixels of a 3x3
    // block that are on a surface with almost the same normal.
    float sum = 0.0;
    float sum_of_squares = 0.0;
    float count = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 tap = pixel + ivec2(x, y);
            if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, size))) {
                continue;
            }
            vec3 tap_normal = imageLoad(images_rgba16f[push.normal], tap).xyz;
            if (dot(normal, tap_normal) < 0.9) {
                continue;
            }
            vec3 tap_light = imageLoad(images_rgba32f[push.color], tap).rgb;
            float value = brightness(min(tap_light, vec3(MAX_LIGHT)));
            sum += value;
            sum_of_squares += value * value;
            count += 1.0;
        }
    }
    // The center pixel always counts, so `count` is 1 or more.
    float mean = sum / count;
    float over_space = max(0.0, sum_of_squares / count - mean * mean);
    float variance = max(over_time, over_space);
    imageStore(images_rgba16f[push.dst], pixel, vec4(light, min(variance, MAX_LIGHT)));
}
