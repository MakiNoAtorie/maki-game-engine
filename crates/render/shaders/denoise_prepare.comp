#version 460
// Pass "denoise_prepare": the first step of the denoiser. See src/denoise.rs for the
// full method.
//
// Reads the accumulated picture and writes, for each pixel:
// - rgb: the light that the surface gets, without the surface color. The picture is
//   divided by the `albedo` image. A filter can then blur the noise of the light and
//   keep the detail of the surface color, which has no noise.
// - a: the variance of the brightness around the pixel: how noisy the picture is
//   there. The filter passes blur more where this is large.
// A pixel with no surface (the background, the light itself) is copied as it is.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// The same binding, seen with the formats of the images.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba32f)
    uniform readonly image2D images_rgba32f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform image2D images_rgba16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform readonly image2D images_rgba8[];

// Must agree with `DenoisePrepare::execute` in src/denoise.rs.
layout(push_constant) uniform Push {
    uint accumulated; // index in `images_rgba32f`
    uint normal;      // index in `images_rgba16f`: surface normal in xyz, zero for no surface
    uint albedo;      // index in `images_rgba8`
    uint dst;         // index in `images_rgba16f`
} push;

// The smallest surface color that the picture is divided by. Must agree with
// denoise_filter.comp, which multiplies by the same value.
const float MIN_ALBEDO = 0.01;
// The largest value of a 16-bit float is 65504.
const float MAX_LIGHT = 60000.0;

float brightness(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// The light at a pixel without the surface color.
vec3 light_at(ivec2 pixel) {
    vec3 color = imageLoad(images_rgba32f[push.accumulated], pixel).rgb;
    vec3 albedo = imageLoad(images_rgba8[push.albedo], pixel).rgb;
    return min(color / max(albedo, vec3(MIN_ALBEDO)), vec3(MAX_LIGHT));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec3 normal = imageLoad(images_rgba16f[push.normal], pixel).xyz;
    if (normal == vec3(0.0)) {
        vec3 color = imageLoad(images_rgba32f[push.accumulated], pixel).rgb;
        imageStore(images_rgba16f[push.dst], pixel, vec4(min(color, vec3(MAX_LIGHT)), 0.0));
        return;
    }
    vec3 light = light_at(pixel);

    // Mean and mean of squares of the brightness, over the pixels of a 3x3 block that
    // are on a surface with almost the same normal. The variance is the difference.
    float sum = 0.0;
    float sum_of_squares = 0.0;
    float count = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 tap = pixel + ivec2(x, y);
            if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, size))) {
                continue;
            }
            vec3 tap_normal = imageLoad(images_rgba16f[push.normal], tap).xyz;
            if (dot(normal, tap_normal) < 0.9) {
                continue;
            }
            float value = brightness(light_at(tap));
            sum += value;
            sum_of_squares += value * value;
            count += 1.0;
        }
    }
    // The center pixel always counts, so `count` is 1 or more.
    float mean = sum / count;
    float variance = max(0.0, sum_of_squares / count - mean * mean);
    imageStore(images_rgba16f[push.dst], pixel, vec4(light, min(variance, MAX_LIGHT)));
}
