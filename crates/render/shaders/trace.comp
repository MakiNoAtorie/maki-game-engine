#version 460
// Pass "trace": the path tracer. For each pixel it follows some random light paths
// (samples) from the camera and writes the mean of the light that the paths bring.
// One frame is noisy; the denoiser passes take the mean over frames and over pixels.
//
// The path of a pixel starts with a camera ray. At each surface that a ray finds:
// - Mirror: the ray continues in the mirror direction.
// - Glass: the ray is reflected or goes through and bends, at random, with the chance
//   that the Fresnel law gives for the angle.
// - Metal and plastic (rough surfaces), if the pixel shows the surface: the reflection
//   of many small mirrors (the GGX model). A shadow ray to a light gives the bright
//   spot of that light, and the path continues in a direction that the small mirrors
//   reflect to. The two ways to find a light share the result (see `light_pdf`).
//   Plastic also has the diffuse part below. This light goes to `specular`.
//   Later on a path (after a bounce, in a reflection on glass), these surfaces count
//   as diffuse: the path has spread out, a sharp reflection of a lamp there would be
//   a rare, very bright sample.
// - A surface with a light of its own (emissive) adds it where a path finds it. No
//   shadow ray aims at it.
// - Diffuse (Lambert: sends light back equally in all directions):
//   1. Direct light: one shadow ray toward a random point of one light. With more
//      than one light, the light is picked at random, with a larger chance for a
//      light that is bright and near. The point is
//      random, so a surface that sees a part of the light is lit in a part of the
//      frames: the mean is a soft shadow.
//   2. One bounce: the ray continues in a random direction. The light that the next
//      diffuse surface gets comes back to this one. This is the light that fills the
//      shadows. The path ends at the second diffuse surface.
// A ray that comes from the camera, a mirror, or glass and finds a sphere light
// brings the light itself: the light shows in the picture, in a mirror, and through glass.
//
// Images written, at the internal resolution. The picture of a pixel is
// `albedo * (direct + indirect) + specular + emission`: the denoiser filters each of
// the first three parts alone.
// - direct:   the light that the surface of the pixel gets straight from the lights,
//             without the color of the surface. Sharp shadows, little noise.
// - indirect: the light that it gets by way of a bounce. Soft, much noise.
// - specular: light with its full color that is not the diffuse light of that
//             surface: the reflection on glass that the camera sees, and the
//             reflection of a rough surface (metal, plastic).
// - emission: the light of a lamp that the pixel shows: the lamp itself, in a mirror,
//             through glass, or as a reflection on glass. Full color. It has no noise
//             (each frame finds the same lamp), and it is thousands of times
//             brighter than the rest: the denoiser must not get it. A mean over time
//             would leave a bright trail behind a reflection that moves. It is stored
//             in the fourth channels of `direct`, `indirect`, and `specular` (R, G, B).
// - normal:   the surface that the pixel shows, for the denoiser: the world normal in
//             xyz and the length of the path from the camera in w, in meters. All
//             zeros: no surface.
// - albedo:   the color of that surface: the part of the light that it sends on to
//             the camera. White for no surface. In the fourth channel: the roughness of
//             a metal or plastic surface, else zero. The denoiser filters the specular
//             light of a rough surface, and not that of a smooth one.
// - motion:   how far the point that the pixel shows moved on the screen since the
//             frame before, in pixels: its position now minus its position then.
//             Zero for no surface. See src/motion.rs.
// Each path of a pixel in a frame goes through the same point of the pixel: its center,
// moved by the jitter of the frame (`push.jitter`). The motion is that of the point,
// without the jitter: it is zero while nothing moves.
//
// "The surface that the pixel shows" is the first diffuse surface on the path:
// - Behind a mirror it is the surface that shows there. The albedo has the tint of
//   the mirror. The pixel shows a picture of the room behind the mirror plane (the
//   virtual image): `normal` is the normal of that picture (the true normal,
//   mirrored), the distance is the full path length, and `motion` is that of the
//   point at this distance along the camera ray. So the denoiser treats the room in
//   the mirror as it treats the room. Correct for a flat mirror and a scene at rest.
// - Glass that the camera sees (also in a mirror) splits the path one time. The path
//   that goes through gives the surface, as for a mirror, with the tint and the part
//   that goes through (1 - reflectance) in the albedo. The reflected path adds to
//   `specular`, times the reflectance. Each later glass surface on the way to the
//   surface lets the path through; after the surface, glass takes one of the two
//   ways at random.
// - No diffuse surface behind the glass: the glass itself is the surface (white),
//   with no light of its own. It only gives the specular light a history.
#include "bindless.glsl"
#include "scene.glsl"
#include "denoise.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// A storage image array names one format. These two arrays are the same binding,
// seen with two formats: each image index is valid only in the array of its format.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform writeonly image2D images_rgba16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rg16f)
    uniform writeonly image2D images_rg16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba32f)
    uniform writeonly image2D images_rgba32f[];

// Must agree with `Trace::execute` in src/passes.rs.
// A vec3 has 12 bytes and an alignment of 16, so one 32-bit value fits after each one.
layout(push_constant) uniform Push {
    vec3 origin;          // camera position, world space
    uint mesh_table;      // index in `mesh_tables`
    // The ray of a pixel is `forward + x * right + y * up`, x and y from -1 to 1.
    // See `Camera::ray_basis` in src/camera.rs.
    vec3 right;
    uint direct;          // index in `images_rgba16f`
    vec3 up;
    uint albedo;          // index in `images_rgba16f`
    vec3 forward;
    uint normal;          // index in `images_rgba16f`
    uint frame;           // number of the frame, for the random numbers
    uint frame_samples;   // paths for each pixel in this frame, 1 or more
    uint max_path_rays;   // the largest number of rays in one path
    uint lights;          // index in `light_buffers`
    uint light_count;     // number of lights in the buffer
    uint motion;          // index in `images_rg16f`
    uint previous_camera; // index in `camera_buffers`
    uint instances;       // index in `instance_buffers`
    // The largest light that a bounce ray adds, in units of the light at the surface
    // that the pixel shows (the light divided by `albedo`). 0: no limit.
    float indirect_clamp;
    uint indirect;        // index in `images_rgba16f`
    uint specular;        // index in `images_rgba16f`
    uint noise;           // index in `noise_buffers`. See src/noise.rs.
    // The offset of all camera rays of this frame from the pixel centers, in pixels,
    // each from -0.5 to 0.5. See src/taa.rs.
    // A vec2 has an alignment of 8: it must start at a multiple of 8 bytes (here 112).
    vec2 jitter;
    uint flags;           // bit 0: use the blue noise. Bit 1: bounce samples for ReSTIR GI
    // With bit 1 of `flags`, the two images for the bounce sample of each pixel (see
    // restir_gi.comp): the low 16 bits are the index of the point image in
    // `images_rgba32f`, the high 16 bits that of the light image in `images_rgba16f`.
    // Two indices in one field: the block is at its size limit of 128 bytes.
    uint gi_images;
} push;

const uint FLAG_BLUE_NOISE = 1u;
const uint FLAG_RESTIR_GI = 2u;

// A sphere light. 48 bytes. Must agree with `light_bytes` in src/light.rs.
struct LightData {
    vec3 position;  // center, world space
    float radius;   // meters
    vec3 radiance;  // the light that each point of the sphere sends out
    float power;    // brightness as one number, for the pick of a light
    // A cone light (a flashlight) sends light only in a cone around `direction`:
    vec3 direction; // length 1
    float cos_cone; // the cosine of the angle from `direction` to the cone edge. -2: all directions
};

// The part of its light that a light sends in the direction `to_point` (from its
// center, length 1): 1 in its cone, 0 out of it, with a soft edge.
float cone_part(LightData light, vec3 to_point) {
    // The edge takes the outer fifth of the cone.
    return smoothstep(light.cos_cone, mix(light.cos_cone, 1.0, 0.2), dot(light.direction, to_point));
}

// The lights are a buffer of the bindless array, as the mesh table is (scene.glsl).
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS, std430) readonly buffer LightBuffer {
    LightData lights[];
} light_buffers[];

LightData light_at(uint index) {
    return light_buffers[nonuniformEXT(push.lights)].lights[index];
}

// The camera of the frame before. 64 bytes. Must agree with `Projection::bytes` in
// src/motion.rs.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS, std430) readonly buffer PreviousCamera {
    vec3 origin;
    vec3 right;   // `right` of the ray basis, divided by its length squared
    vec3 up;      // the same for `up`
    vec3 forward;
} camera_buffers[];

// For each instance of the acceleration structure: its object-to-world matrix of the
// frame before, as three rows. Must agree with `instance_bytes` in src/motion.rs.
struct InstanceData {
    vec4 rows[3];
};
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS, std430) readonly buffer InstanceBuffer {
    InstanceData instances[];
} instance_buffers[];

const float PI = 3.14159265;
const float TAU = 6.28318531;

// The part of a camera ray that can hit, in meters from the camera.
const float T_MIN = 0.01;
const float T_MAX = 1000.0;
// A ray that starts on a surface starts this far above it, in meters. Without the
// gap, rounding errors would let the ray hit the surface that it starts on.
const float SURFACE_GAP = 0.001;

// ---- Random numbers ----
//
// A GPU has no random source. A hash function turns a number into another number that
// looks random; a chain of hashes is the sequence of random numbers of one pixel.
// The start value (the seed) comes from the pixel position and the frame number:
// - the pixel, so that neighbor pixels get different samples (noise, not a pattern);
// - the frame, so that each frame gets different samples. With the same samples in
//   each frame, the mean over frames would be the same noisy picture forever.

uint rng_state;

// The blue-noise pattern: 64 x 64 values from 0 to 1. See src/noise.rs.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS, std430) readonly buffer NoiseBuffer {
    float values[];
} noise_buffers[];

// The pixel of this invocation, and true while the path is at the place where blue
// noise is used: the first path of the frame, at the surface that the pixel shows.
ivec2 noise_pixel;
bool noise_blue = false;

// The PCG hash (Jarzynski and Olano, "Hash Functions for GPU Rendering", 2020).
uint hash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// The next random number of this pixel, from 0.0 (possible) to 1.0 (not possible).
float random() {
    rng_state = hash(rng_state);
    // The top 24 bits: a float holds 24 bits without rounding.
    return float(rng_state >> 8u) / 16777216.0;
}

// Random number `dimension` (0 to 3) of this pixel for the two decisions that make
// most of the noise of a frame: the point on the light (0, 1) and the bounce
// direction (2, 3). Blue noise over the pixels (see src/noise.rs), or the next white
// number if blue noise is off or the path is at another place.
// Each frame and each dimension reads the pattern at another random offset (the
// pattern wraps at its edges). So the four numbers of a pixel do not depend on each
// other, and the numbers of a pixel over frames are white noise: the mean over
// frames converges as before, and each single frame is blue.
// A fixed step for each frame in place of the random offset (a golden-ratio
// sequence for each pixel) was worse than white noise from 16 frames on.
float blue(uint dimension) {
    if (!noise_blue) {
        return random();
    }
    uint shift = hash(push.frame * 4u + dimension);
    ivec2 at = (noise_pixel + ivec2(shift & 63u, (shift >> 6u) & 63u)) & 63;
    return noise_buffers[nonuniformEXT(push.noise)].values[at.y * 64 + at.x];
}

// ---- Directions ----

// The direction at the angle theta from `axis`, turned by the angle `phi` around it.
// `axis` has length 1, and so has the result.
vec3 direction_around(vec3 axis, float cos_theta, float phi) {
    // Two vectors that are square to `axis` and to each other, with no special case
    // (Duff et al., "Building an Orthonormal Basis, Revisited", 2017).
    float s = axis.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + axis.z);
    float b = axis.x * axis.y * a;
    vec3 tangent = vec3(1.0 + s * axis.x * axis.x * a, s * b, -s * axis.x);
    vec3 bitangent = vec3(b, s + axis.y * axis.y * a, -axis.y);

    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    return sin_theta * (cos(phi) * tangent + sin(phi) * bitangent) + cos_theta * axis;
}

// ---- Rays ----

// A point where a ray hit the scene.
struct Surface {
    vec3 position;  // world space
    vec3 normal;    // world space, length 1, on the side that the ray came from
    vec3 albedo;    // the part of the light that the surface sends back, for R, G, and B
    float distance; // from the start of the ray, in meters
    uint material;  // a MATERIAL_* value of scene.glsl
    float param;    // glass: index of refraction. Metal and plastic: roughness
    vec3 emissive;  // the light that the surface sends out by itself
    bool front;     // the ray hit the front side of the triangle (for glass: it goes in)
};

// The surface at the hit of a ray query that found a triangle. `origin` and
// `direction` are those of the ray.
Surface hit_surface(rayQueryEXT query, vec3 origin, vec3 direction) {
    Surface surface;
    // The mesh table index: the first mesh of the instance plus the place of the hit
    // mesh in the instance.
    uint mesh = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
        + rayQueryGetIntersectionGeometryIndexEXT(query, true);
    uint triangle = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
    vec3 mesh_space = mesh_normal(push.mesh_table, mesh, triangle, barycentrics);
    // A normal goes to world space with the transpose of the world-to-object
    // matrix (vector * matrix). This is correct also for a non-uniform scale.
    mat4x3 world_to_object = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    vec3 normal = normalize((mesh_space * world_to_object).xyz);
    // The ray hit the back side of the triangle: the lit side is the other one.
    surface.front = rayQueryGetIntersectionFrontFaceEXT(query, true);
    if (!surface.front) {
        normal = -normal;
    }
    surface.distance = rayQueryGetIntersectionTEXT(query, true);
    surface.position = origin + surface.distance * direction;
    surface.normal = normal;
    mesh_material(push.mesh_table, mesh, surface.albedo, surface.material, surface.param,
        surface.emissive);
    return surface;
}

// Where a world point of the frame before was on the screen of that frame, in pixels.
// The steps of `Projection::pixel` in src/motion.rs.
vec2 previous_screen(vec3 world, vec2 size) {
    vec3 offset = world - camera_buffers[nonuniformEXT(push.previous_camera)].origin;
    float depth = dot(offset, camera_buffers[nonuniformEXT(push.previous_camera)].forward);
    // Behind the camera of the frame before: a place far out of the picture, so a
    // reader finds no history there.
    if (depth <= 0.0) {
        return vec2(-1e4);
    }
    vec2 screen = vec2(dot(offset, camera_buffers[nonuniformEXT(push.previous_camera)].right),
        -dot(offset, camera_buffers[nonuniformEXT(push.previous_camera)].up)) / depth;
    return (screen * 0.5 + 0.5) * size;
}

// Where the point that a ray query hit was in the world one frame before.
vec3 previous_world(rayQueryEXT query) {
    // The point in the space of its instance does not change when the instance moves.
    vec3 object_point = rayQueryGetIntersectionObjectRayOriginEXT(query, true)
        + rayQueryGetIntersectionTEXT(query, true)
        * rayQueryGetIntersectionObjectRayDirectionEXT(query, true);
    uint instance = rayQueryGetIntersectionInstanceIdEXT(query, true);
    InstanceData data = instance_buffers[nonuniformEXT(push.instances)].instances[instance];
    vec4 point = vec4(object_point, 1.0);
    return vec3(dot(data.rows[0], point), dot(data.rows[1], point), dot(data.rows[2], point));
}

// The distance along a ray to the nearest sphere light, the radiance of that light
// toward the start of the ray, and its index. Negative: the ray hits no light.
// The lights are not meshes in the scene, so rays find them with this function only.
// ponytail: tests each light. With some hundreds of lights, put the spheres in the
// TLAS (an instance mask keeps them out of the shadow rays).
float light_distance(vec3 origin, vec3 direction, out vec3 radiance, out uint light_index) {
    float nearest = -1.0;
    for (uint index = 0; index < push.light_count; index++) {
        LightData light = light_at(index);
        vec3 to_center = light.position - origin;
        float along = dot(to_center, direction);
        float discriminant = along * along
            - (dot(to_center, to_center) - light.radius * light.radius);
        if (discriminant <= 0.0) {
            continue;
        }
        float front = along - sqrt(discriminant);
        if (front > 0.0 && (nearest < 0.0 || front < nearest)) {
            nearest = front;
            radiance = light.radiance * cone_part(light, normalize(-to_center));
            light_index = index;
        }
    }
    return nearest;
}

// ---- Light ----

// How much a light matters at a surface point, before shadows: its brightness, over
// the distance squared, times the cosine of the angle at the surface. The cosine is
// that of the point of the sphere that is highest above the surface, so the result is
// zero only for a light that is fully behind the surface.
float light_importance(LightData light, vec3 position, vec3 normal) {
    vec3 to_center = light.position - position;
    float distance_squared = dot(to_center, to_center);
    // The point is in the light.
    if (distance_squared <= light.radius * light.radius) {
        return 0.0;
    }
    float center_distance = sqrt(distance_squared);
    float cosine = min(1.0, (dot(normal, to_center) + light.radius) / center_distance);
    return light.power * cone_part(light, -to_center / center_distance) * max(cosine, 0.0)
        / distance_squared;
}

// A shadow ray to each light at each surface would make the cost of a frame grow with
// the number of lights. The shader traces one shadow ray, to one light, and divides
// the result by the chance of that light. A pick with the same chance for each light
// would be noisy: most picks would be lights that are far away or behind the surface.
// So the shader looks at this many lights and picks one of them with a chance in
// proportion to `light_importance` ("resampled importance sampling", the first step
// of ReSTIR; Bitterli et al., 2020). Looking at a light costs no ray.
const uint LIGHT_CANDIDATES = 8u;

// One random sample of the direct light at a surface point.
// Gives the shadow ray to trace: its direction and its length. Returns the light that
// a white diffuse surface sends out from the point if nothing is on that ray; multiply
// by the albedo. Zero: the sample brings no light, and no ray is necessary.
//
// This is "next-event estimation": a random bounce ray would almost never hit a small
// light, so the shader aims a ray at a light on purpose. From `position` the sphere
// looks like a disk; all directions to the disk make a cone. The shadow ray takes a
// random direction in that cone.
// `chance`: the chance density of the direction, for each unit of solid angle: the
// chance of the light over the size of its cone.
vec3 light_sample(vec3 position, vec3 normal, out vec3 direction, out float to_light,
    out float chance) {
    // 1. Pick a light. With few lights, each one is a candidate; else the candidates
    // are random lights.
    bool all = push.light_count <= LIGHT_CANDIDATES;
    uint candidates = all ? push.light_count : LIGHT_CANDIDATES;
    // One random number makes the pick: each candidate takes the place of the pick
    // before it with the chance `its importance / sum so far`. This gives each
    // candidate the chance `its importance / sum of all`.
    float pick = random();
    float sum = 0.0;
    uint chosen = 0u;
    float chosen_importance = 0.0;
    for (uint candidate = 0u; candidate < candidates; candidate++) {
        uint index = all
            ? candidate
            : min(uint(random() * float(push.light_count)), push.light_count - 1u);
        float importance = light_importance(light_at(index), position, normal);
        if (importance <= 0.0) {
            continue;
        }
        sum += importance;
        if (pick * sum < importance) {
            chosen = index;
            chosen_importance = importance;
            // Stretch the two parts of the range back to 0..1: `pick` stays a random
            // number that is independent of the decision.
            pick = pick * sum / importance;
        } else {
            pick = (pick * sum - importance) / (sum - importance);
        }
    }
    // No light, or all lights are behind the surface.
    if (sum == 0.0) {
        return vec3(0.0);
    }
    // One over the chance of the chosen light. For random candidates, their mean
    // importance stands for the mean of all lights.
    float scale = sum / chosen_importance;
    if (!all) {
        scale *= float(push.light_count) / float(LIGHT_CANDIDATES);
    }
    LightData light = light_at(chosen);

    // 2. A direction to that light.
    vec3 to_center = light.position - position;
    float distance_squared = dot(to_center, to_center);
    float radius_squared = light.radius * light.radius;
    float center_distance = sqrt(distance_squared);
    // theta_max is the angle between the cone axis and the cone edge.
    float sin2_max = radius_squared / distance_squared;
    float cos_max = sqrt(1.0 - sin2_max);
    // 1 - cos_max, in a form that keeps its digits for a small or far light.
    float one_minus_cos_max = sin2_max / (1.0 + cos_max);

    // A direction in the cone, with the same chance for each direction.
    float cos_theta = 1.0 - blue(0u) * one_minus_cos_max;
    direction = direction_around(to_center / center_distance, cos_theta, TAU * blue(1u));

    // Light that comes in at a flat angle is spread over more surface (Lambert's law).
    float cos_surface = dot(normal, direction);
    if (cos_surface <= 0.0) {
        return vec3(0.0); // This point of the light is behind the surface.
    }
    // The shadow ray ends where it reaches the sphere.
    float along = center_distance * cos_theta;
    to_light = along - sqrt(max(0.0, along * along - (distance_squared - radius_squared)));
    // The size of the cone, as a solid angle: how large the light looks from here.
    float solid_angle = TAU * one_minus_cos_max;
    chance = 1.0 / (solid_angle * scale);
    // A diffuse surface sends out 1/pi of the light that it gets, in each direction.
    return light.radiance * cone_part(light, -to_center / center_distance)
        * (cos_surface * solid_angle / PI * scale);
}

// The chance density with which `light_sample` at a surface point gives a direction
// to the light `index`. For a ray that found the light in another way (the reflection
// of a rough surface): how likely the shadow ray was to find it too.
float light_pdf(uint index, vec3 position, vec3 normal) {
    float pick = 1.0 / float(push.light_count);
    if (push.light_count <= LIGHT_CANDIDATES) {
        float sum = 0.0;
        float own = 0.0;
        for (uint other = 0u; other < push.light_count; other++) {
            float importance = light_importance(light_at(other), position, normal);
            sum += importance;
            own = other == index ? importance : own;
        }
        if (own <= 0.0) {
            return 0.0;
        }
        pick = own / sum;
    }
    LightData light = light_at(index);
    vec3 to_center = light.position - position;
    float sin2_max = light.radius * light.radius / dot(to_center, to_center);
    if (sin2_max >= 1.0) {
        return 0.0;
    }
    return pick / (TAU * sin2_max / (1.0 + sqrt(1.0 - sin2_max)));
}

// ---- Rough surfaces (GGX) ----
//
// A rough surface is many small mirrors (facets), too small to see. `alpha` (the
// roughness squared) tells how far their normals spread around the surface normal.
// The functions below are the GGX model (Walter et al., 2007) in the usual form:
// D: how many facets have a given normal. G1: the part of them that the other facets
// do not hide, seen from a direction. F: the part of the light that a facet reflects.

// D: the density of facets whose normal is at the cosine `n_h` from the surface normal.
float ggx_d(float n_h, float alpha) {
    float a2 = alpha * alpha;
    float d = n_h * n_h * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

// G1: the part of the facets that is visible from a direction at the cosine `n_v`
// from the surface normal.
float ggx_g1(float n_v, float alpha) {
    float a2 = alpha * alpha;
    return 2.0 * n_v / (n_v + sqrt(a2 + (1.0 - a2) * n_v * n_v));
}

// F: the reflected part, from `f0` for light straight at a facet to all of it for
// light along the facet (Schlick). `v_h`: the cosine between the light and the facet
// normal. Metal: `f0` is its color. Plastic and other non-metals: 0.04.
vec3 fresnel(vec3 f0, float v_h) {
    return f0 + (1.0 - f0) * pow(1.0 - v_h, 5.0);
}

// A random facet normal among those that are visible from `out_direction` (toward the
// viewer, length 1): a ray reflected at it is a sample of the reflection. The chance
// density of that reflected direction is `ggx_g1(n_out) * ggx_d(n_h) / (4 * n_out)`.
// The method: stretch the view direction by alpha, pick a point on the cap of the unit
// sphere that it sees, stretch back (Dupuy and Benyoub, "Sampling Visible GGX Normals
// with Spherical Caps", 2023).
vec3 visible_normal(vec3 normal, vec3 out_direction, float alpha, vec2 random_pair) {
    // The same basis as `direction_around`.
    float s = normal.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + normal.z);
    float b = normal.x * normal.y * a;
    vec3 tangent = vec3(1.0 + s * normal.x * normal.x * a, s * b, -s * normal.x);
    vec3 bitangent = vec3(b, s + normal.y * normal.y * a, -normal.y);

    vec3 view = vec3(dot(out_direction, tangent), dot(out_direction, bitangent),
        dot(out_direction, normal));
    vec3 stretched = normalize(vec3(view.xy * alpha, view.z));
    float phi = TAU * random_pair.x;
    float z = (1.0 - random_pair.y) * (1.0 + stretched.z) - stretched.z;
    float sin_theta = sqrt(clamp(1.0 - z * z, 0.0, 1.0));
    vec3 facet = vec3(sin_theta * cos(phi), sin_theta * sin(phi), z) + stretched;
    facet = normalize(vec3(facet.xy * alpha, max(facet.z, 1e-6)));
    return facet.x * tangent + facet.y * bitangent + facet.z * normal;
}

// ---- The path ----

// The light of the paths of this pixel, summed over the samples of the frame. See the
// top of the file for the three parts.
vec3 sum_direct = vec3(0.0);
vec3 sum_indirect = vec3(0.0);
vec3 sum_specular = vec3(0.0);
vec3 sum_emission = vec3(0.0);

// With ReSTIR GI (`FLAG_RESTIR_GI`): the bounce light of the first path of the frame
// is not added to `sum_indirect`. It is the sample of the pixel for the pass
// "restir_gi": the point that the bounce ray found, and the light from there.
bool gi_path = false;    // the path is past the bounce of such a sample
vec3 gi_sum = vec3(0.0); // its bounce light

// Bounce light with the limit `push.indirect_clamp`.
// Most bounce rays bring a little light. A rare one finds the light itself by way of
// a mirror or through glass and brings some thousand times more (a "firefly"). The
// mean of such samples needs thousands of frames, and the filter spreads each one to
// a soft dot. The limit makes that light darker than it is: a small, steady error in
// place of a large, random one.
vec3 limited(vec3 light) {
    float value = brightness(light);
    return push.indirect_clamp > 0.0 && value > push.indirect_clamp
        ? light * (push.indirect_clamp / value)
        : light;
}

// Adds the light that a path found to the part that it belongs to.
// `bounced`: the path had left a diffuse surface. `reflection`: the path is the
// reflection on glass.
void add_light(vec3 light, bool bounced, bool reflection) {
    if (bounced) {
        light = limited(light);
    }
    if (reflection) {
        sum_specular += light;
    } else if (bounced) {
        if (gi_path) {
            gi_sum += light;
        } else {
            sum_indirect += light;
        }
    } else {
        sum_direct += light;
    }
}

// A direction in the picture behind a mirror with the normal `mirror`: the reflection
// at the mirror plane, v - 2 (v . n) n. No change for a zero `mirror`.
vec3 mirrored(vec3 direction, vec3 mirror) {
    return direction - 2.0 * dot(direction, mirror) * mirror;
}

// Follows one random path through the pixel and adds its light to the sums.
// `first`: also write the normal, albedo, and motion images.
void trace_path(ivec2 pixel, ivec2 size, bool first) {
    // A point of the pixel, from -1 to 1 across the image. Image y goes down, `up`
    // goes up. Each path of the pixel in this frame takes the same point: the light
    // then belongs to the surface that the normal and albedo images hold. With a
    // random point for each path, a pixel on an edge would hold the light of two
    // surfaces, divided by the color of one. The point changes from frame to frame
    // (the jitter), and the pass "taa" takes the mean over frames: smooth edges.
    vec2 in_image = vec2(pixel) + 0.5 + push.jitter;
    vec2 screen = in_image / vec2(size) * 2.0 - 1.0;
    vec3 direction = normalize(push.forward + screen.x * push.right - screen.y * push.up);
    vec3 camera_direction = direction;

    // The ray to trace next. A path has two kinds of ray: path rays, which find the
    // next surface, and shadow rays, which only test if the light is visible.
    // The loop below has one place that traces a ray, for the two kinds. A GPU runs
    // the pixels of a group in step: with two places, the pixels that wait for a
    // shadow ray would stand still while the others trace a path ray.
    vec3 origin = push.origin;
    float t_min = T_MIN;
    float t_max = T_MAX;
    // Opaque: all geometry is opaque, so the ray query never has to ask the shader.
    // Cull back faces: the camera is outside of the room and looks in through the
    // back side of the near walls. Only camera rays cull; for all other rays the
    // walls are solid from the two sides.
    uint flags = gl_RayFlagsOpaqueEXT | gl_RayFlagsCullBackFacingTrianglesEXT;

    // The part of the light at the end of the path that reaches the camera. Each
    // surface on the way takes a part away. At the surface that the pixel shows it
    // goes into the albedo image and starts again at 1: from there the path holds
    // light without the color of that surface.
    vec3 throughput = vec3(1.0);
    // True if the ray can bring the light of the sphere light itself. False after a
    // diffuse surface: its shadow ray already counted that light.
    bool sees_light = true;
    bool bounced = false; // the path has left a diffuse surface
    uint segment = 0;     // number of the path ray, from 0

    // The way from the camera to the surface that the pixel shows.
    bool surface_found = false; // the path is past that surface, or ended with none
    float path_length = 0.0;    // from the camera to the start of the ray, in meters
    bool chain = false;         // a mirror or glass is on the way
    // The normal of the first mirror on the way. A reflection at its plane turns a
    // direction into the picture behind the mirror. Zero: no mirror, no change.
    // ponytail: the first mirror only. Behind two mirrors the normal of the picture is
    // not correct: the filter then takes each pixel there for a surface of its own
    // (no blur, more noise). Keep a matrix for all mirrors if that shows.
    vec3 mirror_normal = vec3(0.0);
    bool glass_seen = false;      // glass is on the way
    vec4 glass_guide = vec4(0.0); // normal and path length of the first glass surface

    // The reflection on that first glass surface: a second path, traced after the
    // first one ends.
    bool pending = false;
    vec3 pending_origin;
    vec3 pending_direction;
    vec3 pending_throughput;
    uint pending_segment;
    bool reflection = false; // the path is that second path

    // The bounce sample for ReSTIR GI: the first surface that the bounce ray finds.
    bool gi_seen = false;    // the bounce ray has found a surface
    bool gi_valid = false;   // a diffuse one: another pixel can use the sample too
    vec3 gi_point;
    vec3 gi_normal;
    // The chance with which a plastic surface took the diffuse bounce. The path counts
    // its light divided by it; the sample holds the light itself.
    float gi_chance = 1.0;

    // State of the reflection ray of a rough surface: the path ray after that surface.
    // It can find a light, as the shadow ray of the surface can: the two share the
    // light by their chances ("multiple importance sampling", Veach, 1995), so a
    // small light on a smooth surface and a large light on a rough one both have
    // little noise.
    bool glossy_ray = false; // the ray to trace is such a ray
    float glossy_chance;     // the chance density of its direction
    vec3 glossy_normal;      // the normal of the surface that it left (`origin` is the point)

    // State of a shadow ray.
    bool shadow = false;   // the ray to trace is a shadow ray
    vec3 shadow_light;     // the light that the path gets if the shadow ray hits nothing
    vec3 shadow_specular = vec3(0.0); // the same, for the reflection of a rough surface
    bool shadow_bounced;   // `bounced` at the surface of the shadow ray
    bool shadow_reflection; // `reflection` at that surface
    bool continues;        // a path ray follows the shadow ray
    vec3 bounce_direction; // its direction. It starts where the shadow ray starts.

    while (true) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, scene_tlas, flags, 0xFFu, origin, t_min, direction, t_max);
        // Each step moves the search forward. At the end the query holds the nearest
        // hit, or for a shadow ray the first hit that the search found.
        while (rayQueryProceedEXT(query)) {}
        bool hit = rayQueryGetIntersectionTypeEXT(query, true)
            == gl_RayQueryCommittedIntersectionTriangleEXT;

        bool done = false; // the path ends with this ray
        if (shadow) {
            shadow = false;
            if (!hit) {
                add_light(shadow_light, shadow_bounced, shadow_reflection);
                sum_specular += shadow_specular;
            }
            if (continues) {
                // The bounce ray, from the same point.
                direction = bounce_direction;
                t_max = T_MAX;
                flags = gl_RayFlagsOpaqueEXT;
                continue;
            }
            done = true;
        } else {
            Surface surface;
            if (hit) {
                surface = hit_surface(query, origin, direction);
            }
            vec3 light_radiance;
            uint light_index;
            float light = light_distance(origin, direction, light_radiance, light_index);
            bool light_is_nearer = light > 0.0 && (!hit || light < surface.distance);
            // On the way from the camera to the surface that the pixel shows.
            bool to_surface = !surface_found && !reflection;
            if ((sees_light && light_is_nearer) || !hit) {
                if (sees_light && light_is_nearer) {
                    vec3 light_seen = throughput * light_radiance;
                    if (glossy_ray) {
                        // The reflection ray of a rough surface found the light. Its
                        // shadow ray can find it too: this ray gets the part that
                        // belongs to its chance.
                        float chance = light_pdf(light_index, origin, glossy_normal);
                        float mine = glossy_chance * glossy_chance;
                        sum_specular += light_seen * (mine / (mine + chance * chance));
                    } else if (bounced) {
                        // The bounce ray found the light by way of a mirror or glass.
                        add_light(light_seen, true, reflection);
                    } else {
                        sum_emission += light_seen;
                    }
                }
                // The path ends with no diffuse surface: the pixel shows the light
                // itself or the background, behind glass or not.
                if (to_surface) {
                    surface_found = true;
                    if (first) {
                        vec2 motion = glass_seen
                            ? in_image - previous_screen(
                                push.origin + camera_direction * glass_guide.w, vec2(size))
                            : vec2(0.0);
                        imageStore(images_rgba16f[push.normal], pixel, glass_guide);
                        imageStore(images_rgba16f[push.albedo], pixel, vec4(1.0));
                        imageStore(images_rg16f[push.motion], pixel, vec4(motion, 0.0, 0.0));
                    }
                }
                done = true;
            } else {
                // The next ray starts on this surface.
                t_min = 0.0;
                flags = gl_RayFlagsOpaqueEXT;
                glossy_ray = false;
                bool gi_first = gi_path && !gi_seen;
                gi_seen = gi_seen || gi_path;
                if (to_surface) {
                    path_length += surface.distance;
                }

                // The last ray of the path: a mirror or glass cannot send the ray on. The
                // surface counts as diffuse, so it gets direct light and is not a black hole.
                segment++;
                bool last = segment == push.max_path_rays;
                if (surface.material == MATERIAL_MIRROR && !last) {
                    throughput *= surface.albedo;
                    if (to_surface && !chain) {
                        mirror_normal = surface.normal;
                    }
                    chain = chain || to_surface;
                    origin = surface.position + surface.normal * SURFACE_GAP;
                    direction = reflect(direction, surface.normal);
                    sees_light = true;
                } else if (surface.material == MATERIAL_GLASS && !last) {
                    // The ratio of the two indices of refraction: air (1.0) to glass on the
                    // way in, glass to air on the way out.
                    float eta = surface.front ? 1.0 / surface.param : surface.param;
                    vec3 refracted = refract(direction, surface.normal, eta);
                    // The part of the light that the surface reflects (Fresnel law, in the
                    // short form of Schlick): small for a ray straight at the surface, all
                    // of the light for a ray along it.
                    // A zero vector from `refract`: no ray can leave the glass at this
                    // angle, and all light is reflected (total internal reflection).
                    float reflectance = 1.0;
                    if (refracted != vec3(0.0)) {
                        float r0 = (1.0 - surface.param) / (1.0 + surface.param);
                        r0 *= r0;
                        // The formula uses the angle on the air side of the surface.
                        float cos_air = surface.front
                            ? dot(-direction, surface.normal)
                            : dot(refracted, -surface.normal);
                        reflectance = r0 + (1.0 - r0) * pow(1.0 - cos_air, 5.0);
                    }
                    bool reflects;
                    if (to_surface) {
                        // The way to the surface must be the same in each frame, so
                        // that the normal and albedo images do not change: the path
                        // goes through where it can.
                        chain = true;
                        if (!glass_seen) {
                            // The first glass surface: the two ways, as two paths.
                            glass_seen = true;
                            glass_guide = vec4(mirrored(surface.normal, mirror_normal), path_length);
                            pending = true;
                            pending_origin = surface.position + surface.normal * SURFACE_GAP;
                            pending_direction = reflect(direction, surface.normal);
                            pending_throughput = throughput * reflectance;
                            pending_segment = segment;
                            throughput *= 1.0 - reflectance;
                        }
                        // ponytail: a later glass surface on the way (the far side of
                        // a ball) lets all light through. The part that it reflects
                        // back into the glass (4 % and more) is not followed.
                        reflects = refracted == vec3(0.0);
                    } else {
                        // One ray cannot split. It takes one of the two ways at random,
                        // with the reflectance as the chance: the mean over samples has
                        // the two parts.
                        reflects = random() < reflectance;
                    }
                    if (reflects) {
                        origin = surface.position + surface.normal * SURFACE_GAP;
                        direction = reflect(direction, surface.normal);
                    } else {
                        throughput *= surface.albedo;
                        origin = surface.position - surface.normal * SURFACE_GAP;
                        direction = refracted;
                    }
                    sees_light = true;
                } else {
                    // Diffuse, metal, or plastic. All rays from here start a small gap
                    // above the surface.
                    origin = surface.position + surface.normal * SURFACE_GAP;
                    if (gi_first) {
                        gi_valid = true;
                        gi_point = surface.position;
                        gi_normal = surface.normal;
                    }
                    // The light of the surface itself, as the light of a lamp: with no
                    // noise where the pixel shows it, as bounce light after a bounce.
                    if (surface.emissive != vec3(0.0)) {
                        vec3 own = throughput * surface.emissive;
                        if (bounced) {
                            add_light(own, true, reflection);
                        } else if (to_surface) {
                            sum_emission += own;
                        } else {
                            sum_specular += own;
                        }
                    }
                    // The rough reflection, only at the surface that the pixel shows.
                    bool glossy = to_surface && surface.material >= MATERIAL_METAL;
                    bool metal = surface.material == MATERIAL_METAL;
                    // The values of the rough reflection. Not computed for a diffuse
                    // surface, which is most of them.
                    float alpha = 1.0;
                    vec3 out_direction = -direction;
                    float n_out = 1.0;
                    vec3 f0 = vec3(0.04);
                    float glossy_pick = 0.0;
                    vec3 diffuse_color = surface.albedo;
                    if (glossy) {
                        alpha = surface.param * surface.param;
                        n_out = max(dot(surface.normal, out_direction), 1e-4);
                        f0 = metal ? surface.albedo : vec3(0.04);
                        // A facet reflects a part (F); the rest goes into the plastic
                        // and comes back as diffuse light. Metal has no diffuse light.
                        vec3 mirror_part = fresnel(f0, n_out);
                        diffuse_color = metal ? vec3(0.0) : surface.albedo * (1.0 - mirror_part);
                        // The chance that the path of a plastic surface continues with
                        // the reflection and not with the diffuse bounce: about the
                        // part of the light that each one sends on.
                        glossy_pick = metal ? 1.0 : clamp(
                            mirror_part.g / (mirror_part.g + brightness(diffuse_color) + 1e-4),
                            0.1, 0.9);
                    }
                    // The light on the way to this surface, without its color.
                    vec3 before = throughput;
                    throughput *= diffuse_color;
                    if (to_surface) {
                        // The surface that the pixel shows. Stored here and not after the
                        // loop: the values then do not have to stay alive through all rays,
                        // which made the pass 8 % slower.
                        surface_found = true;
                        if (first) {
                            // Behind a mirror or glass: the point at the path length
                            // along the camera ray, with the camera of the frame
                            // before. Else the true point, with the transform of its
                            // instance in the frame before (`query` is the camera ray).
                            vec3 was = chain
                                ? push.origin + camera_direction * path_length
                                : previous_world(query);
                            vec2 motion = in_image - previous_screen(was, vec2(size));
                            imageStore(images_rgba16f[push.normal], pixel,
                                vec4(mirrored(surface.normal, mirror_normal), path_length));
                            // Metal has no diffuse light: any color does. Its own color
                            // makes the "surface color" debug view complete.
                            imageStore(images_rgba16f[push.albedo], pixel, vec4(
                                glossy && metal ? before * surface.albedo : throughput,
                                glossy ? surface.param : 0.0));
                            imageStore(images_rg16f[push.motion], pixel, vec4(motion, 0.0, 0.0));
                        }
                        throughput = glossy && metal ? vec3(0.0) : vec3(1.0);
                    }
                    vec3 light_direction;
                    float to_light;
                    float light_chance;
                    // The surface that the pixel shows, on the first path of the frame.
                    noise_blue = (push.flags & FLAG_BLUE_NOISE) != 0u && first && to_surface;
                    vec3 lambert = light_sample(surface.position, surface.normal, light_direction,
                        to_light, light_chance);
                    shadow_light = throughput * lambert;
                    shadow_specular = vec3(0.0);
                    if (glossy && lambert != vec3(0.0)) {
                        // The bright spot of the light on the rough surface: the
                        // facets that reflect the light to the viewer have the normal
                        // half way between the two directions.
                        vec3 half_way = normalize(out_direction + light_direction);
                        float n_in = dot(surface.normal, light_direction);
                        // The chance density with which the reflection ray below
                        // takes this direction.
                        float chance = ggx_g1(n_out, alpha)
                            * ggx_d(dot(surface.normal, half_way), alpha) / (4.0 * n_out);
                        // The light that the facets send to the viewer, for light of
                        // 1 from this direction.
                        vec3 reflected = fresnel(f0, dot(out_direction, half_way)) * chance
                            * ggx_g1(n_in, alpha);
                        // `lambert` has the factor `cosine / pi` of a diffuse surface.
                        float mine = light_chance * light_chance;
                        float other = chance * glossy_pick;
                        shadow_specular = before * lambert * (PI / n_in) * reflected
                            * (mine / (mine + other * other));
                    }
                    shadow_bounced = bounced;
                    shadow_reflection = reflection;
                    // The path ends at the second diffuse surface, and at the last ray.
                    // ponytail: the reflection on glass ends at its first diffuse
                    // surface: it shows the room with direct light only. The glass
                    // reflects some percent of the light, so the missing bounce light
                    // is some percent of some percent, and the path is half as long.
                    continues = !bounced && !last && !reflection;
                    if (continues && glossy && (metal || random() < glossy_pick)) {
                        // The reflection ray of the rough surface.
                        vec3 facet = visible_normal(surface.normal, out_direction, alpha,
                            vec2(blue(2u), blue(3u)));
                        bounce_direction = reflect(direction, facet);
                        float n_in = dot(surface.normal, bounce_direction);
                        // Below the surface: another facet takes the light.
                        continues = n_in > 0.0;
                        if (continues) {
                            // The light that the ray brings counts by `F * G1`: the
                            // rest of the model is in the choice of the direction.
                            throughput = before * fresnel(f0, dot(out_direction, facet))
                                * ggx_g1(n_in, alpha) / glossy_pick;
                            glossy_ray = true;
                            glossy_chance = ggx_g1(n_out, alpha)
                                * ggx_d(dot(surface.normal, facet), alpha) / (4.0 * n_out)
                                * glossy_pick;
                            glossy_normal = surface.normal;
                            // From here the light of the path is specular light.
                            reflection = true;
                            bounced = true;
                            sees_light = true;
                        }
                    } else if (continues) {
                        // The bounce. A diffuse surface gets the most light from straight above
                        // and none from the side (Lambert's law again). The random direction has
                        // the same weight: more rays near the normal. Then each ray counts the
                        // same, and the light that it brings is only multiplied by the albedo.
                        bounce_direction = direction_around(surface.normal, sqrt(blue(2u)), TAU * blue(3u));
                        if (glossy) {
                            // Plastic took the diffuse bounce, with this chance.
                            throughput /= 1.0 - glossy_pick;
                        }
                        // A sample for ReSTIR GI: not behind a mirror or glass, where
                        // the pass cannot compute the surface point of the pixel.
                        gi_path = (push.flags & FLAG_RESTIR_GI) != 0u && first && to_surface
                            && !chain;
                        gi_chance = 1.0 - glossy_pick;
                        bounced = true;
                        sees_light = false;
                    }
                    noise_blue = false;
                    if (shadow_light != vec3(0.0) || shadow_specular != vec3(0.0)) {
                        // Only "something or nothing" matters for a shadow ray, so the search
                        // stops at the first triangle.
                        shadow = true;
                        direction = light_direction;
                        t_max = to_light;
                        flags = gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT;
                    } else if (continues) {
                        direction = bounce_direction;
                    } else {
                        done = true;
                    }
                }
            }
        }
        if (done) {
            if (!pending) {
                break;
            }
            // The second path of the pixel: the reflection on the glass.
            pending = false;
            reflection = true;
            glossy_ray = false;
            origin = pending_origin;
            direction = pending_direction;
            throughput = pending_throughput;
            segment = pending_segment;
            t_min = 0.0;
            t_max = T_MAX;
            flags = gl_RayFlagsOpaqueEXT;
            sees_light = true;
            bounced = false;
        }
    }

    // The bounce sample of the pixel, or "no sample".
    if (first && (push.flags & FLAG_RESTIR_GI) != 0u) {
        vec4 point = vec4(0.0, 0.0, 0.0, 2.0);
        vec4 light = vec4(0.0);
        if (gi_path && gi_valid) {
            // The normal as two numbers (the octahedral map of scene.glsl).
            vec3 n = gi_normal / (abs(gi_normal.x) + abs(gi_normal.y) + abs(gi_normal.z));
            vec2 packed = n.z >= 0.0
                ? n.xy
                : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
            point = vec4(gi_point, packed.y);
            light = vec4(min(gi_sum * gi_chance, vec3(MAX_LIGHT)), packed.x);
        } else if (gi_path) {
            // The bounce ray found a mirror, glass, or nothing: no pixel but this one
            // can use that. The light counts as before, and the sample is a black
            // one: the reservoir holds the light of the diffuse points only, and a
            // ray that found none of them is a sample of that light too (zero). With
            // no sample here, the reservoir would count only the rays that found
            // light, and the result would be too bright.
            sum_indirect += gi_sum;
            point.w = 0.0;
        }
        imageStore(images_rgba32f[push.gi_images & 0xFFFFu], pixel, point);
        imageStore(images_rgba16f[push.gi_images >> 16u], pixel, light);
    }
    gi_path = false;
    gi_sum = vec3(0.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.direct]);
    // The work groups cover full 8x8 blocks, so some invocations are out of the image.
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    rng_state = hash(uint(pixel.x) + hash(uint(pixel.y) + hash(push.frame)));
    noise_pixel = pixel;

    // The random chain of the pixel continues from one sample to the next.
    for (uint s = 0; s < push.frame_samples; s++) {
        trace_path(pixel, size, s == 0);
    }
    // The images have 16-bit floats, whose largest value is 65504: a small light is
    // brighter than that and would be stored as infinity.
    float scale = 1.0 / float(push.frame_samples);
    vec3 emission = min(sum_emission * scale, vec3(MAX_LIGHT));
    imageStore(images_rgba16f[push.direct], pixel,
        vec4(min(sum_direct * scale, vec3(MAX_LIGHT)), emission.r));
    imageStore(images_rgba16f[push.indirect], pixel,
        vec4(min(sum_indirect * scale, vec3(MAX_LIGHT)), emission.g));
    imageStore(images_rgba16f[push.specular], pixel,
        vec4(min(sum_specular * scale, vec3(MAX_LIGHT)), emission.b));
}
