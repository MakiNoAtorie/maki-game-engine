#version 460
// Pass "trace": the path tracer. For each pixel it follows some random light paths
// (samples) from the camera and writes the mean of the light that the paths bring.
// One frame is noisy; the pass "accumulate" takes the mean over frames.
//
// The path of a pixel starts with a camera ray. At each surface that a ray finds:
// - Mirror: the ray continues in the mirror direction.
// - Glass: the ray is reflected or goes through and bends, at random, with the chance
//   that the Fresnel law gives for the angle.
// - Diffuse (Lambert: sends light back equally in all directions):
//   1. Direct light: one shadow ray toward a random point of one light. With more
//      than one light, the light is picked at random, with a larger chance for a
//      light that is bright and near. The point is
//      random, so a surface that sees a part of the light is lit in a part of the
//      frames: the mean is a soft shadow.
//   2. One bounce: the ray continues in a random direction. The light that the next
//      diffuse surface gets comes back to this one. This is the light that fills the
//      shadows. The path ends at the second diffuse surface.
// A ray that comes from the camera, a mirror, or glass and finds a sphere light
// brings the light itself: the light shows in the picture, in a mirror, and through glass.
//
// Images written, at the internal resolution:
// - radiance: the mean light of the paths, linear RGB. Black on a miss. Alpha is 1.0
//             if a path saw the light itself, else 0.0 (for accumulate.comp).
// - normal:   the surface that the pixel shows, for the denoiser: the world normal in
//             xyz and the distance from the camera in w, in meters. All zeros: no surface.
// - albedo:   the color of that surface: the part of the light that it sends on to
//             the camera. White for no surface.
// "The surface that the pixel shows" is the first diffuse surface on the first path of
// the pixel. Behind a mirror or glass it is the surface that shows there, and its
// color has the tint of the mirror or the glass. The radiance of the pixel is this
// color times the light that the surface gets, so a filter can work on the light alone.

#include "bindless.glsl"
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// A storage image array names one format. These two arrays are the same binding,
// seen with two formats: each image index is valid only in the array of its format.
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform writeonly image2D images_rgba16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform writeonly image2D images_rgba8[];

// Must agree with `Trace::execute` in src/passes.rs.
// A vec3 has 12 bytes and an alignment of 16, so one 32-bit value fits after each one.
layout(push_constant) uniform Push {
    vec3 origin;          // camera position, world space
    uint mesh_table;      // index in `mesh_tables`
    // The ray of a pixel is `forward + x * right + y * up`, x and y from -1 to 1.
    // See `Camera::ray_basis` in src/camera.rs.
    vec3 right;
    uint radiance;        // index in `images_rgba16f`
    vec3 up;
    uint albedo;          // index in `images_rgba8`
    vec3 forward;
    uint normal;          // index in `images_rgba16f`
    uint frame;           // number of the frame, for the random numbers
    uint frame_samples;   // paths for each pixel in this frame, 1 or more
    uint max_path_rays;   // the largest number of rays in one path
    uint lights;          // index in `light_buffers`
    uint light_count;     // number of lights in the buffer
} push;

// A sphere light. 32 bytes. Must agree with `light_bytes` in src/light.rs.
struct LightData {
    vec3 position;  // center, world space
    float radius;   // meters
    vec3 radiance;  // the light that each point of the sphere sends out
    float power;    // brightness as one number, for the pick of a light
};

// The lights are a buffer of the bindless array, as the mesh table is (scene.glsl).
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS, std430) readonly buffer LightBuffer {
    LightData lights[];
} light_buffers[];

LightData light_at(uint index) {
    return light_buffers[nonuniformEXT(push.lights)].lights[index];
}

const float PI = 3.14159265;
const float TAU = 6.28318531;

// The part of a camera ray that can hit, in meters from the camera.
const float T_MIN = 0.01;
const float T_MAX = 1000.0;
// A ray that starts on a surface starts this far above it, in meters. Without the
// gap, rounding errors would let the ray hit the surface that it starts on.
const float SURFACE_GAP = 0.001;

// ---- Random numbers ----
//
// A GPU has no random source. A hash function turns a number into another number that
// looks random; a chain of hashes is the sequence of random numbers of one pixel.
// The start value (the seed) comes from the pixel position and the frame number:
// - the pixel, so that neighbor pixels get different samples (noise, not a pattern);
// - the frame, so that each frame gets different samples. With the same samples in
//   each frame, the mean over frames would be the same noisy picture forever.

uint rng_state;

// True if a path of the pixel found the light itself.
bool saw_light = false;

// The PCG hash (Jarzynski and Olano, "Hash Functions for GPU Rendering", 2020).
uint hash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// The next random number of this pixel, from 0.0 (possible) to 1.0 (not possible).
float random() {
    rng_state = hash(rng_state);
    // The top 24 bits: a float holds 24 bits without rounding.
    return float(rng_state >> 8u) / 16777216.0;
}

// ---- Directions ----

// The direction at the angle theta from `axis`, turned by the angle `phi` around it.
// `axis` has length 1, and so has the result.
vec3 direction_around(vec3 axis, float cos_theta, float phi) {
    // Two vectors that are square to `axis` and to each other, with no special case
    // (Duff et al., "Building an Orthonormal Basis, Revisited", 2017).
    float s = axis.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + axis.z);
    float b = axis.x * axis.y * a;
    vec3 tangent = vec3(1.0 + s * axis.x * axis.x * a, s * b, -s * axis.x);
    vec3 bitangent = vec3(b, s + axis.y * axis.y * a, -axis.y);

    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    return sin_theta * (cos(phi) * tangent + sin(phi) * bitangent) + cos_theta * axis;
}

// ---- Rays ----

// A point where a ray hit the scene.
struct Surface {
    vec3 position;  // world space
    vec3 normal;    // world space, length 1, on the side that the ray came from
    vec3 albedo;    // the part of the light that the surface sends back, for R, G, and B
    float distance; // from the start of the ray, in meters
    uint material;  // a MATERIAL_* value of scene.glsl
    float ior;      // index of refraction, for glass
    bool front;     // the ray hit the front side of the triangle (for glass: it goes in)
};

// The surface at the hit of a ray query that found a triangle. `origin` and
// `direction` are those of the ray.
Surface hit_surface(rayQueryEXT query, vec3 origin, vec3 direction) {
    Surface surface;
    // The mesh table index: the first mesh of the instance plus the place of the hit
    // mesh in the instance.
    uint mesh = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)
        + rayQueryGetIntersectionGeometryIndexEXT(query, true);
    uint triangle = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
    vec3 mesh_space = mesh_normal(push.mesh_table, mesh, triangle, barycentrics);
    // A normal goes to world space with the transpose of the world-to-object
    // matrix (vector * matrix). This is correct also for a non-uniform scale.
    mat4x3 world_to_object = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    vec3 normal = normalize((mesh_space * world_to_object).xyz);
    // The ray hit the back side of the triangle: the lit side is the other one.
    surface.front = rayQueryGetIntersectionFrontFaceEXT(query, true);
    if (!surface.front) {
        normal = -normal;
    }
    surface.distance = rayQueryGetIntersectionTEXT(query, true);
    surface.position = origin + surface.distance * direction;
    surface.normal = normal;
    mesh_material(push.mesh_table, mesh, surface.albedo, surface.material, surface.ior);
    return surface;
}

// The distance along a ray to the nearest sphere light, and the radiance of that
// light. Negative: the ray hits no light.
// The lights are not meshes in the scene, so rays find them with this function only.
// ponytail: tests each light. With some hundreds of lights, put the spheres in the
// TLAS (an instance mask keeps them out of the shadow rays).
float light_distance(vec3 origin, vec3 direction, out vec3 radiance) {
    float nearest = -1.0;
    for (uint index = 0; index < push.light_count; index++) {
        LightData light = light_at(index);
        vec3 to_center = light.position - origin;
        float along = dot(to_center, direction);
        float discriminant = along * along
            - (dot(to_center, to_center) - light.radius * light.radius);
        if (discriminant <= 0.0) {
            continue;
        }
        float front = along - sqrt(discriminant);
        if (front > 0.0 && (nearest < 0.0 || front < nearest)) {
            nearest = front;
            radiance = light.radiance;
        }
    }
    return nearest;
}

// ---- Light ----

// How much a light matters at a surface point, before shadows: its brightness, over
// the distance squared, times the cosine of the angle at the surface. The cosine is
// that of the point of the sphere that is highest above the surface, so the result is
// zero only for a light that is fully behind the surface.
float light_importance(LightData light, vec3 position, vec3 normal) {
    vec3 to_center = light.position - position;
    float distance_squared = dot(to_center, to_center);
    // The point is in the light.
    if (distance_squared <= light.radius * light.radius) {
        return 0.0;
    }
    float center_distance = sqrt(distance_squared);
    float cosine = min(1.0, (dot(normal, to_center) + light.radius) / center_distance);
    return light.power * max(cosine, 0.0) / distance_squared;
}

// A shadow ray to each light at each surface would make the cost of a frame grow with
// the number of lights. The shader traces one shadow ray, to one light, and divides
// the result by the chance of that light. A pick with the same chance for each light
// would be noisy: most picks would be lights that are far away or behind the surface.
// So the shader looks at this many lights and picks one of them with a chance in
// proportion to `light_importance` ("resampled importance sampling", the first step
// of ReSTIR; Bitterli et al., 2020). Looking at a light costs no ray.
const uint LIGHT_CANDIDATES = 8u;

// One random sample of the direct light at a surface point.
// Gives the shadow ray to trace: its direction and its length. Returns the light that
// a white diffuse surface sends out from the point if nothing is on that ray; multiply
// by the albedo. Zero: the sample brings no light, and no ray is necessary.
//
// This is "next-event estimation": a random bounce ray would almost never hit a small
// light, so the shader aims a ray at a light on purpose. From `position` the sphere
// looks like a disk; all directions to the disk make a cone. The shadow ray takes a
// random direction in that cone.
vec3 light_sample(vec3 position, vec3 normal, out vec3 direction, out float to_light) {
    // 1. Pick a light. With few lights, each one is a candidate; else the candidates
    // are random lights.
    bool all = push.light_count <= LIGHT_CANDIDATES;
    uint candidates = all ? push.light_count : LIGHT_CANDIDATES;
    // One random number makes the pick: each candidate takes the place of the pick
    // before it with the chance `its importance / sum so far`. This gives each
    // candidate the chance `its importance / sum of all`.
    float pick = random();
    float sum = 0.0;
    uint chosen = 0u;
    float chosen_importance = 0.0;
    for (uint candidate = 0u; candidate < candidates; candidate++) {
        uint index = all
            ? candidate
            : min(uint(random() * float(push.light_count)), push.light_count - 1u);
        float importance = light_importance(light_at(index), position, normal);
        if (importance <= 0.0) {
            continue;
        }
        sum += importance;
        if (pick * sum < importance) {
            chosen = index;
            chosen_importance = importance;
            // Stretch the two parts of the range back to 0..1: `pick` stays a random
            // number that is independent of the decision.
            pick = pick * sum / importance;
        } else {
            pick = (pick * sum - importance) / (sum - importance);
        }
    }
    // No light, or all lights are behind the surface.
    if (sum == 0.0) {
        return vec3(0.0);
    }
    // One over the chance of the chosen light. For random candidates, their mean
    // importance stands for the mean of all lights.
    float scale = sum / chosen_importance;
    if (!all) {
        scale *= float(push.light_count) / float(LIGHT_CANDIDATES);
    }
    LightData light = light_at(chosen);

    // 2. A direction to that light.
    vec3 to_center = light.position - position;
    float distance_squared = dot(to_center, to_center);
    float radius_squared = light.radius * light.radius;
    float center_distance = sqrt(distance_squared);
    // theta_max is the angle between the cone axis and the cone edge.
    float sin2_max = radius_squared / distance_squared;
    float cos_max = sqrt(1.0 - sin2_max);
    // 1 - cos_max, in a form that keeps its digits for a small or far light.
    float one_minus_cos_max = sin2_max / (1.0 + cos_max);

    // A direction in the cone, with the same chance for each direction.
    float cos_theta = 1.0 - random() * one_minus_cos_max;
    direction = direction_around(to_center / center_distance, cos_theta, TAU * random());

    // Light that comes in at a flat angle is spread over more surface (Lambert's law).
    float cos_surface = dot(normal, direction);
    if (cos_surface <= 0.0) {
        return vec3(0.0); // This point of the light is behind the surface.
    }
    // The shadow ray ends where it reaches the sphere.
    float along = center_distance * cos_theta;
    to_light = along - sqrt(max(0.0, along * along - (distance_squared - radius_squared)));
    // The size of the cone, as a solid angle: how large the light looks from here.
    float solid_angle = TAU * one_minus_cos_max;
    // A diffuse surface sends out 1/pi of the light that it gets, in each direction.
    return light.radiance * (cos_surface * solid_angle / PI * scale);
}

// The light that one random path through the pixel brings to the camera.
// `first`: also write the depth and normal images.
vec3 path_radiance(ivec2 pixel, ivec2 size, bool first) {
    // A random point in the pixel, from -1 to 1 across the image. Image y goes down,
    // `up` goes up. The point changes with each sample, so the mean smooths the edges.
    vec2 screen = (vec2(pixel) + vec2(random(), random())) / vec2(size) * 2.0 - 1.0;
    vec3 direction = normalize(push.forward + screen.x * push.right - screen.y * push.up);

    vec3 radiance = vec3(0.0);

    // The ray to trace next. A path has two kinds of ray: path rays, which find the
    // next surface, and shadow rays, which only test if the light is visible.
    // The loop below has one place that traces a ray, for the two kinds. A GPU runs
    // the pixels of a group in step: with two places, the pixels that wait for a
    // shadow ray would stand still while the others trace a path ray.
    vec3 origin = push.origin;
    float t_min = T_MIN;
    float t_max = T_MAX;
    // Opaque: all geometry is opaque, so the ray query never has to ask the shader.
    // Cull back faces: the camera is outside of the room and looks in through the
    // back side of the near walls. Only camera rays cull; for all other rays the
    // walls are solid from the two sides.
    uint flags = gl_RayFlagsOpaqueEXT | gl_RayFlagsCullBackFacingTrianglesEXT;

    // The part of the light at the end of the path that reaches the camera. Each
    // surface on the way takes a part away.
    vec3 throughput = vec3(1.0);
    // True if the ray can bring the light of the sphere light itself. False after a
    // diffuse surface: its shadow ray already counted that light.
    bool sees_light = true;
    bool bounced = false; // the path has left a diffuse surface
    uint segment = 0;     // number of the path ray, from 0

    // State of a shadow ray.
    bool shadow = false;   // the ray to trace is a shadow ray
    vec3 shadow_light;     // the light that the path gets if the shadow ray hits nothing
    bool continues;        // a path ray follows the shadow ray
    vec3 bounce_direction; // its direction. It starts where the shadow ray starts.

    while (true) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, scene_tlas, flags, 0xFFu, origin, t_min, direction, t_max);
        // Each step moves the search forward. At the end the query holds the nearest
        // hit, or for a shadow ray the first hit that the search found.
        while (rayQueryProceedEXT(query)) {}
        bool hit = rayQueryGetIntersectionTypeEXT(query, true)
            == gl_RayQueryCommittedIntersectionTriangleEXT;

        if (shadow) {
            if (!hit) {
                radiance += shadow_light;
            }
            if (!continues) {
                break;
            }
            // The bounce ray, from the same point.
            shadow = false;
            direction = bounce_direction;
            t_max = T_MAX;
            flags = gl_RayFlagsOpaqueEXT;
            continue;
        }

        Surface surface;
        if (hit) {
            surface = hit_surface(query, origin, direction);
        }
        vec3 light_radiance;
        float light = light_distance(origin, direction, light_radiance);
        bool light_is_nearer = light > 0.0 && (!hit || light < surface.distance);
        if ((sees_light && light_is_nearer) || !hit) {
            if (sees_light && light_is_nearer) {
                radiance += throughput * light_radiance;
                saw_light = true;
            }
            // The path ends with no diffuse surface: the pixel shows the light itself
            // or the background.
            if (first && !bounced) {
                imageStore(images_rgba16f[push.normal], pixel, vec4(0.0));
                imageStore(images_rgba8[push.albedo], pixel, vec4(1.0));
            }
            break;
        }
        // The next ray starts on this surface.
        t_min = 0.0;
        flags = gl_RayFlagsOpaqueEXT;

        // The last ray of the path: a mirror or glass cannot send the ray on. The
        // surface counts as diffuse, so it gets direct light and is not a black hole.
        segment++;
        bool last = segment == push.max_path_rays;
        if (surface.material == MATERIAL_MIRROR && !last) {
            throughput *= surface.albedo;
            origin = surface.position + surface.normal * SURFACE_GAP;
            direction = reflect(direction, surface.normal);
            sees_light = true;
        } else if (surface.material == MATERIAL_GLASS && !last) {
            // The ratio of the two indices of refraction: air (1.0) to glass on the
            // way in, glass to air on the way out.
            float eta = surface.front ? 1.0 / surface.ior : surface.ior;
            vec3 refracted = refract(direction, surface.normal, eta);
            // The part of the light that the surface reflects (Fresnel law, in the
            // short form of Schlick): small for a ray straight at the surface, all
            // of the light for a ray along it.
            // A zero vector from `refract`: no ray can leave the glass at this
            // angle, and all light is reflected (total internal reflection).
            float reflectance = 1.0;
            if (refracted != vec3(0.0)) {
                float r0 = (1.0 - surface.ior) / (1.0 + surface.ior);
                r0 *= r0;
                // The formula uses the angle on the air side of the surface.
                float cos_air = surface.front
                    ? dot(-direction, surface.normal)
                    : dot(refracted, -surface.normal);
                reflectance = r0 + (1.0 - r0) * pow(1.0 - cos_air, 5.0);
            }
            // One ray cannot split. It takes one of the two ways at random, with the
            // reflectance as the chance: the mean over samples has the two parts.
            if (random() < reflectance) {
                origin = surface.position + surface.normal * SURFACE_GAP;
                direction = reflect(direction, surface.normal);
            } else {
                throughput *= surface.albedo;
                origin = surface.position - surface.normal * SURFACE_GAP;
                direction = refracted;
            }
            sees_light = true;
        } else {
            // Diffuse. All rays from here start a small gap above the surface.
            origin = surface.position + surface.normal * SURFACE_GAP;
            throughput *= surface.albedo;
            if (first && !bounced) {
                // The surface that the pixel shows. Stored here and not after the
                // loop: the values then do not have to stay alive through all rays,
                // which made the pass 8 % slower.
                float from_camera = distance(surface.position, push.origin);
                imageStore(images_rgba16f[push.normal], pixel, vec4(surface.normal, from_camera));
                imageStore(images_rgba8[push.albedo], pixel, vec4(throughput, 1.0));
            }
            vec3 light_direction;
            float to_light;
            shadow_light = throughput
                * light_sample(surface.position, surface.normal, light_direction, to_light);
            // The path ends at the second diffuse surface, and at the last ray.
            continues = !bounced && !last;
            if (continues) {
                // The bounce. A diffuse surface gets the most light from straight above
                // and none from the side (Lambert's law again). The random direction has
                // the same weight: more rays near the normal. Then each ray counts the
                // same, and the light that it brings is only multiplied by the albedo.
                bounce_direction = direction_around(surface.normal, sqrt(random()), TAU * random());
                bounced = true;
                sees_light = false;
            }
            if (shadow_light != vec3(0.0)) {
                // Only "something or nothing" matters for a shadow ray, so the search
                // stops at the first triangle.
                shadow = true;
                direction = light_direction;
                t_max = to_light;
                flags = gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT;
            } else if (continues) {
                direction = bounce_direction;
            } else {
                break;
            }
        }
    }
    return radiance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.radiance]);
    // The work groups cover full 8x8 blocks, so some invocations are out of the image.
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    rng_state = hash(uint(pixel.x) + hash(uint(pixel.y) + hash(push.frame)));

    // The random chain of the pixel continues from one sample to the next.
    vec3 radiance = vec3(0.0);
    for (uint s = 0; s < push.frame_samples; s++) {
        radiance += path_radiance(pixel, size, s == 0);
    }
    radiance /= float(push.frame_samples);
    // The image has 16-bit floats, whose largest value is 65504: a small light is
    // brighter than that and would be stored as infinity.
    imageStore(images_rgba16f[push.radiance], pixel, vec4(min(radiance, vec3(60000.0)), float(saw_light)));
}
