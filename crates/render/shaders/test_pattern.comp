#version 460
// Pass "test_pattern": writes a moving gradient into the HDR image.
// Linear color. The brightness rises to 4.0 from left to right, so the right side
// shows that the tonemap pass compresses values above 1.0.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform writeonly image2D images[];

// Must agree with `TestPattern::execute` in src/passes.rs.
layout(push_constant) uniform Push {
    float seconds;
    uint hdr; // index in `images`
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images[push.hdr]);
    // The work groups cover full 8x8 blocks, so some invocations are out of the image.
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float wave = 0.5 + 0.5 * sin(6.2831853 * (uv.x + 0.5 * uv.y) + push.seconds);
    // Dark red to dark blue.
    vec3 color = mix(vec3(0.35, 0.02, 0.04), vec3(0.02, 0.05, 0.30), wave);
    float brightness = mix(0.25, 4.0, uv.x);
    imageStore(images[push.hdr], pixel, vec4(color * brightness, 1.0));
}
