#version 460
// Pass "denoise_resolve": the last step of the denoiser. Puts the kinds of light
// together and writes the picture: `albedo * (direct + indirect) + specular + emission`.
// See src/denoise.rs for the full method.

#include "bindless.glsl"
#include "denoise.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform image2D images_rgba16f[];

// Must agree with `DenoiseResolve::execute` in src/denoise.rs.
// All are indices in `images_rgba16f`.
layout(push_constant) uniform Push {
    uint direct;   // the direct light after its filter passes, in rgb
    uint indirect; // the indirect light after its filter passes, in rgb
    uint specular; // the mean specular light
    uint albedo;   // the surface color. White for no surface.
    uint dst;
    // The three light images of the trace pass. Their fourth channels are the R, G,
    // and B of the emission of this frame.
    uint emission_r;
    uint emission_g;
    uint emission_b;
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    // A pixel with no surface has emission only: the other three are zero.
    vec3 light = imageLoad(images_rgba16f[push.direct], pixel).rgb
        + imageLoad(images_rgba16f[push.indirect], pixel).rgb;
    vec3 color = imageLoad(images_rgba16f[push.albedo], pixel).rgb * light
        + imageLoad(images_rgba16f[push.specular], pixel).rgb
        + vec3(imageLoad(images_rgba16f[push.emission_r], pixel).a,
            imageLoad(images_rgba16f[push.emission_g], pixel).a,
            imageLoad(images_rgba16f[push.emission_b], pixel).a);
    imageStore(images_rgba16f[push.dst], pixel, vec4(min(color, vec3(MAX_LIGHT)), 1.0));
}
