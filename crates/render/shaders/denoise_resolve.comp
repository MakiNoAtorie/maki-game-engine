#version 460
// Pass "denoise_resolve": the last step of the denoiser. Multiplies the light by the
// surface color again and writes the picture. See src/denoise.rs for the full method.

#include "bindless.glsl"
#include "denoise.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba16f)
    uniform image2D images_rgba16f[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform readonly image2D images_rgba8[];

// Must agree with `DenoiseResolve::execute` in src/denoise.rs.
layout(push_constant) uniform Push {
    uint src;    // index in `images_rgba16f`: light in rgb
    uint dst;    // index in `images_rgba16f`
    uint normal; // index in `images_rgba16f`: normal in xyz, zero for no surface
    uint albedo; // index in `images_rgba8`
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images_rgba16f[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec3 color = imageLoad(images_rgba16f[push.src], pixel).rgb;
    // No surface: the value is a full color already.
    if (imageLoad(images_rgba16f[push.normal], pixel).xyz != vec3(0.0)) {
        vec3 albedo = imageLoad(images_rgba8[push.albedo], pixel).rgb;
        color = min(color * max(albedo, vec3(MIN_ALBEDO)), vec3(MAX_LIGHT));
    }
    imageStore(images_rgba16f[push.dst], pixel, vec4(color, 1.0));
}
