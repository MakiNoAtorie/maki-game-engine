#version 460
// Pass "tonemap": reads the picture and writes display color into the output image.
// The picture has the size of the output (the pass "taa" did the scaling). With a debug
// view it shows another image in place of the picture, of any size.
//
// The picture holds light: values from 0 to far above 1. A display shows 0 to 1.
// The steps, for the picture (a debug view has only steps 3 and 6):
// 1. Bloom: a small part of the blurred picture (src/bloom.rs) is blended in.
// 2. Vignette: the corners get darker, as with a real lens. It leads the eye to the
//    middle.
// 3. Exposure sets which amount of light is "bright", and the tone curve bends all
//    values into 0..1 so that a bright area keeps some detail and does not go flat
//    white. Two curves (`push.curve`): AgX and Khronos PBR Neutral.
// 4. The grade: lift, gamma, gain for R, G, and B, the three controls of a colorist.
// 5. The sRGB curve of the display.
// 6. Dither: the output has 8 bits, 256 steps. In a dark, smooth gradient (most of a
//    horror picture) the eye sees each step as a band. Noise of one step, different
//    in each pixel and frame, turns the bands into grain too fine to see.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_SAMPLED_IMAGES) uniform texture2D textures[];
layout(set = BINDLESS_SET, binding = BINDLESS_SAMPLERS) uniform sampler samplers[];
layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform writeonly image2D images[];

// Must agree with `Tonemap::execute` in src/passes.rs.
layout(push_constant) uniform Push {
    uint hdr;         // index in `textures`: the picture
    uint hdr_sampler; // index in `samplers`
    uint dst;         // index in `images`
    float exposure;   // the light is multiplied by this before the curve
    uint mode;        // a MODE_* value: what to show
    uint normal;      // index in `textures`: normal in xyz (zero: no surface), distance in w
    // Indices in `textures`: the images of the debug view. See the MODE_* values.
    uint a;
    uint b;
    uint c;
    uint d;
    // The look. See the top of the file.
    uint bloom;           // index in `textures`: the sum of the bloom blurs, half size
    float bloom_strength; // the part of the blur in the picture, times 1 / blurs. 0: none
    uint curve;           // a CURVE_* value
    float vignette;       // how dark the corners get, 0 (not at all) to 1 (black)
    uint frame;           // number of the frame, for the dither
    uint pad0;            // a vec3 has an alignment of 16: the next one starts at 64
    vec3 lift;
    float pad1;
    vec3 gamma;
    float pad2;
    vec3 gain;
    float pad3;
} push;

// Must agree with `ToneCurve` in the render crate (`settings.rs`).
const uint CURVE_AGX = 0u;
const uint CURVE_NEUTRAL = 1u;

// What the pass shows. `Tonemap::execute` chooses the mode and the images `a` to `d`
// for each `DebugView`.
const uint MODE_PICTURE = 0u;   // the picture `hdr`, through the tone curve
const uint MODE_LIGHT = 1u;     // rgb of `a` as light, through the tone curve
// `a * (b + c) + d` as light, plus the fourth channels of b, c, d as a color: albedo,
// direct, indirect, specular, and the emission (see trace.glsl).
const uint MODE_SUM = 2u;
const uint MODE_MOTION = 3u;    // `a`: screen motion in pixels
const uint MODE_DEPTH = 4u;     // the distance of `normal`
const uint MODE_NORMALS = 5u;   // the normal of `normal`
const uint MODE_SAMPLES = 6u;   // the fourth channel of `a`: a sample count
const uint MODE_DEVIATION = 7u; // `a`: mean brightness and mean of its square, in b and a
const uint MODE_NOISE = 8u;     // `a`: light in rgb, its variance in a
const uint MODE_COLOR = 9u;     // rgb of `a` as a surface color

// An image through the sampler, at a place from 0 to 1.
vec3 sampled(uint texture_index, vec2 uv) {
    // A compute shader has no automatic mip level, so the level is explicit.
    return textureLod(sampler2D(textures[texture_index], samplers[push.hdr_sampler]), uv, 0.0).rgb;
}

// The nearest pixel of an image, with no blend: a debug view shows true values. Also,
// not each image format permits a blend.
vec4 pixel_at(uint texture_index, vec2 uv) {
    ivec2 size = textureSize(sampler2D(textures[texture_index], samplers[push.hdr_sampler]), 0);
    return texelFetch(sampler2D(textures[texture_index], samplers[push.hdr_sampler]), ivec2(uv * vec2(size)), 0);
}

float brightness(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// The color of a debug view that does not show light, at `uv`, in linear display range.
vec3 debug_color(vec2 uv) {
    if (push.mode == MODE_MOTION) {
        // Black for no motion. A motion of 1 pixel is well visible; 5 are almost full.
        return 1.0 - exp(-0.5 * vec3(abs(pixel_at(push.a, uv).xy), 0.0));
    }
    vec4 surface = pixel_at(push.normal, uv);
    if (surface.xyz == vec3(0.0)) {
        return vec3(0.0); // No surface.
    }
    if (push.mode == MODE_DEPTH) {
        return vec3(exp(-0.08 * surface.w));
    }
    if (push.mode == MODE_SAMPLES) {
        // A log scale: 1 sample is dark, 32 are half, 1024 are white.
        return vec3(log2(1.0 + pixel_at(push.a, uv).a) / 10.0);
    }
    if (push.mode == MODE_DEVIATION) {
        // How noisy one frame is: the standard deviation of its brightness over time,
        // as a part of the brightness.
        vec2 moments = pixel_at(push.a, uv).zw;
        float deviation = sqrt(max(0.0, moments.y - moments.x * moments.x));
        return vec3(deviation / (moments.x + 1e-3) * 0.25);
    }
    if (push.mode == MODE_NOISE) {
        // The noise that the filter takes the mean to have, as a part of its
        // brightness. Black: the filter changes nothing here.
        vec4 light = pixel_at(push.a, uv);
        return vec3(sqrt(light.a) / (brightness(light.rgb) + 1e-3));
    }
    if (push.mode == MODE_COLOR) {
        return pixel_at(push.a, uv).rgb;
    }
    return surface.xyz * 0.5 + 0.5;
}

// The AgX tone curve (Troy Sobotka, 2022; the short form of Benjamin Wrensch, "Minimal
// AgX Implementation", 2023). The look of film: a bright, colored light goes to a
// pale color and then to white, with no jump of the hue (the short ACES form turned a
// bright red lamp orange and then yellow). Soft colors, soft contrast.
// 1. Into the AgX color space: each channel gets a part of the other two.
// 2. The brightness as stops (log2), from 12.5 stops below 1.0 to 4 stops above.
// 3. An S curve over that range (here a polynomial that is close to it).
// 4. Back to linear display colors.
vec3 agx(vec3 light) {
    const mat3 into = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0784335999999992, 0.878468636469772, 0.0784336,
        0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 back = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    const float LOWEST = -12.47393;
    const float HIGHEST = 4.026069;
    vec3 x = clamp(log2(max(into * light, vec3(1e-10))), LOWEST, HIGHEST);
    x = (x - LOWEST) / (HIGHEST - LOWEST);
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    x = 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2
        + 0.1191 * x - 0.00232;
    // The curve gives display values with a gamma of 2.2.
    return pow(max(back * x, vec3(0.0)), vec3(2.2));
}

// The Khronos PBR Neutral tone curve (Khronos Group, 2024). Colors up to 0.76 stay as
// the scene has them (a small offset takes the gray haze of dark colors away); only
// brighter ones are pressed into the range, toward white. Colors as authored, more
// contrast than AgX.
vec3 neutral(vec3 color) {
    const float START = 0.8 - 0.04; // the press starts here
    const float TO_WHITE = 0.15;    // how fast a bright color loses its color
    float lowest = min(color.r, min(color.g, color.b));
    color -= lowest < 0.08 ? lowest - 6.25 * lowest * lowest : 0.04;
    float peak = max(color.r, max(color.g, color.b));
    if (peak < START) {
        return color;
    }
    float d = 1.0 - START;
    float new_peak = 1.0 - d * d / (peak + d - START);
    color *= new_peak / peak;
    float white = 1.0 - 1.0 / (TO_WHITE * (peak - new_peak) + 1.0);
    return mix(color, vec3(new_peak), white);
}

// Light to linear display color, 0 to 1.
vec3 tone_curve(vec3 light) {
    return clamp(push.curve == CURVE_AGX ? agx(light) : neutral(light), 0.0, 1.0);
}

// A random number from 0.0 to 1.0 for a pixel and a frame (the PCG hash, as in
// trace.glsl).
float pixel_random(uvec3 v) {
    uint state = (v.x + v.y * 7919u + v.z * 104729u) * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return float(((word >> 22u) ^ word) >> 8u) / 16777216.0;
}

// The 8-bit color for the output, with dither: noise of one 8-bit step, as the sum of
// two random numbers (a triangle shape: its mean and its strength do not depend on
// the color, so no pattern shows).
vec4 stored(vec3 encoded, ivec2 pixel) {
    float noise = pixel_random(uvec3(pixel, push.frame))
        + pixel_random(uvec3(pixel, push.frame + 1013u)) - 1.0;
    return vec4(encoded + noise / 255.0, 1.0);
}

// Linear color to the sRGB transfer curve. The output image and the swapchain are
// UNORM formats, so the encoding is done here and not by the GPU.
vec3 srgb_encode(vec3 linear) {
    vec3 low = linear * 12.92;
    vec3 high = 1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055;
    return mix(low, high, step(vec3(0.0031308), linear));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images[push.dst]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    // The views that show light go through the tone curve, as the picture does.
    vec3 hdr;
    if (push.mode == MODE_PICTURE) {
        hdr = sampled(push.hdr, uv);
    } else if (push.mode == MODE_LIGHT) {
        hdr = pixel_at(push.a, uv).rgb;
    } else if (push.mode == MODE_SUM) {
        vec4 direct = pixel_at(push.b, uv);
        vec4 indirect = pixel_at(push.c, uv);
        vec4 specular = pixel_at(push.d, uv);
        hdr = pixel_at(push.a, uv).rgb * (direct.rgb + indirect.rgb) + specular.rgb
            + vec3(direct.a, indirect.a, specular.a);
    } else {
        vec3 color = debug_color(uv);
        // A surface color is linear, as light is. The other views show plain numbers.
        if (push.mode == MODE_COLOR) {
            color = srgb_encode(color);
        }
        imageStore(images[push.dst], pixel, vec4(color, 1.0));
        return;
    }
    if (push.mode == MODE_PICTURE) {
        if (push.bloom_strength > 0.0) {
            hdr = mix(hdr, sampled(push.bloom, uv), push.bloom_strength);
        }
        // From the middle of the picture (0) to a corner (1), the same in X and Y.
        float from_middle = length(uv * 2.0 - 1.0) / sqrt(2.0);
        hdr *= 1.0 - push.vignette * smoothstep(0.35, 1.0, from_middle);
    }
    vec3 mapped = tone_curve(hdr * push.exposure);
    if (push.mode == MODE_PICTURE) {
        // Lift moves black toward a color, gain scales white, gamma bends the middle.
        mapped = push.gain * (mapped + push.lift * (1.0 - mapped));
        mapped = pow(clamp(mapped, 0.0, 1.0), 1.0 / push.gamma);
    }
    imageStore(images[push.dst], pixel, stored(srgb_encode(mapped), pixel));
}
