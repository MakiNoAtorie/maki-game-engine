#version 460
// TEMPORARY: stage 3 proof. Delete together with src/gradient.rs.
// Writes a moving gradient between the two palette colors into a storage image.

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_BUFFERS) readonly buffer Palette {
    vec4 colors[2];
} palettes[];

layout(set = BINDLESS_SET, binding = BINDLESS_STORAGE_IMAGES, rgba8)
    uniform writeonly image2D images[];

// Must agree with `draw` in src/gradient.rs.
layout(push_constant) uniform Push {
    float seconds;
    uint image;   // index in `images`
    uint palette; // index in `palettes`
} push;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(images[push.image]);
    // The work groups cover full 8x8 blocks, so some invocations are out of the image.
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float wave = 0.5 + 0.5 * sin(6.2831853 * (uv.x + 0.5 * uv.y) + push.seconds);
    vec4 color = mix(palettes[push.palette].colors[0], palettes[push.palette].colors[1], wave);
    imageStore(images[push.image], pixel, color);
}
