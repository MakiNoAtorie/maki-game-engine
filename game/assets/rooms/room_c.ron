// Room C: the material test room. Rough metal and plastic, a surface with a light of
// its own, a cone light, and the lamp. No way to another room.
// The format is `RoomDef` in crates/scene/src/room.rs.
(
    width: 8.0,
    depth: 8.0,
    height: 3.0,
    next_id: 13,
    objects: [
        // Metal: from almost a mirror to dull.
        (
            id: 1,
            pose: (position: (-2.4, 0.5, -0.6)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.5, segments: 48, rings: 24),
                    look: (color: (1.0, 0.78, 0.34), material: Metal(roughness: 0.15)),
                ),
            },
        ),
        (
            id: 2,
            pose: (position: (-1.1, 0.5, -0.6)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.5, segments: 48, rings: 24),
                    look: (color: (1.0, 0.78, 0.34), material: Metal(roughness: 0.35)),
                ),
            },
        ),
        (
            id: 3,
            pose: (position: (0.2, 0.5, -0.6)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.5, segments: 48, rings: 24),
                    look: (color: (0.9, 0.9, 0.92), material: Metal(roughness: 0.6)),
                ),
            },
        ),
        // Plastic: a smooth and a rough coat.
        (
            id: 4,
            pose: (position: (1.5, 0.5, -0.6)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.5, segments: 48, rings: 24),
                    look: (color: (0.7, 0.08, 0.06), material: Plastic(roughness: 0.12)),
                ),
            },
        ),
        (
            id: 5,
            pose: (position: (2.8, 0.5, -0.6)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.5, segments: 48, rings: 24),
                    look: (color: (0.1, 0.25, 0.6), material: Plastic(roughness: 0.45)),
                ),
            },
        ),
        // A plastic floor plate in front of the spheres: it shows the reflections.
        (
            id: 6,
            pose: (position: (0.2, 0.02, 1.2), scale: (6.4, 0.04, 1.6)),
            components: {
                "prop": (
                    mesh: Cube(1.0),
                    look: (color: (0.05, 0.05, 0.055), material: Plastic(roughness: 0.2)),
                    collider: false,
                ),
            },
        ),
        // A panel with a light of its own, on the back wall.
        (
            id: 7,
            pose: (position: (-2.2, 1.6, -3.9), scale: (1.6, 0.5, 0.05)),
            components: {
                "prop": (
                    mesh: Cube(1.0),
                    look: (color: (0.0, 0.0, 0.0), emissive: (0.3, 1.6, 2.0)),
                    collider: false,
                ),
            },
        ),
        (
            id: 8,
            name: "lamp",
            pose: (position: (0.5, 2.3, 1.8)),
            components: {"light": (radius: 0.15, color: (1.0, 0.9, 0.8), intensity: 9.0)},
        ),
        // A cone light from above the right wall, down to the two plastic spheres.
        (
            id: 9,
            name: "spot",
            pose: (position: (3.4, 2.7, -2.6)),
            components: {
                "light": (
                    radius: 0.06,
                    color: (1.0, 0.95, 0.85),
                    intensity: 30.0,
                    direction: (-0.35, -1.0, 0.75),
                    cone: 22.0,
                ),
            },
        ),
        (id: 10, name: "start", pose: (position: (-3.2, 0.0, 2.6)), components: {"spawn": ()}),
        // The spot light pulses while the player stands under it (the script of the
        // game). Not the first light: the benchmark moves that one.
        (
            id: 11,
            name: "beacon",
            pose: (position: (3.4, 0.0, -2.6)),
            components: {"area": (width: 1.6, depth: 1.6), "beacon": (light: 9, pulses: 1.5, strength: 0.6)},
        ),
        // A dial near the start: a row changes a field of the beacon, and a row calls
        // a function of the script crate (game/scripts/src/beacon.rs).
        (
            id: 12,
            name: "dial",
            pose: (position: (-1.6, 0.0, 2.6)),
            components: {
                "area": (width: 0.8, depth: 0.8),
                "event": (
                    pages: [
                        (
                            trigger: Interact,
                            commands: [SetField(11, "beacon", "pulses", 4.0), CallScript("beacon_forget")],
                        ),
                    ],
                ),
            },
        ),
    ],
)
