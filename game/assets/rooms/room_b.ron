// Room B: the switch room, east of room A.
// The format is `RoomDef` in crates/scene/src/room.rs; an event is the component
// "event" (`EventPages` in crates/events/src/model.rs). Lengths are meters, angles degrees.
(
    width: 6.0,
    depth: 5.0,
    height: 3.0,
    objects: [
        // The switch: a red button on a post.
        (
            name: "post",
            pose: (position: (2.2, 0.0, -1.5)),
            components: {
                "prop": (
                    mesh: Cuboid((-0.15, 0.0, -0.15), (0.15, 0.9, 0.15)),
                    look: (color: (0.3, 0.3, 0.32)),
                ),
            },
        ),
        (
            name: "button",
            pose: (position: (2.2, 0.98, -1.5)),
            components: {"prop": (mesh: Cube(0.16), look: (color: (0.8, 0.05, 0.05)), collider: false)},
        ),
        (
            pose: (position: (-1.2, 0.4, -1.4)),
            components: {
                "prop": (
                    mesh: Sphere(radius: 0.4, segments: 32, rings: 16),
                    look: (color: (0.85, 0.85, 0.85), material: Mirror),
                ),
            },
        ),
        (
            pose: (position: (0.6, 0.4, 1.3), rotation: (0.0, 30.0, 0.0)),
            components: {"prop": (mesh: Cube(0.8), look: (color: (0.25, 0.5, 0.3)))},
        ),
        // The cabinet of room A, at the back wall.
        (
            name: "cabinet",
            pose: (position: (-2.3, 0.0, -2.2)),
            components: {"prop": (mesh: File("models/cabinet.glb"))},
        ),
        (
            name: "lamp_b",
            pose: (position: (0.0, 2.3, 0.2)),
            components: {"light": (radius: 0.15, color: (0.9, 0.95, 1.0), intensity: 9.0)},
        ),
        // A small red light at the switch: the room is not black when the lamp is off.
        (
            name: "pilot",
            pose: (position: (2.2, 1.35, -1.5)),
            components: {"light": (radius: 0.04, color: (1.0, 0.15, 0.1), intensity: 0.5)},
        ),
        // In the west wall: the way back to room A.
        (components: {"doorway": (wall: NegX, offset: 0.0, width: 1.2, height: 2.1, depth: 1.5)}),
        (name: "west", pose: (position: (-2.2, 0.0, 0.0)), components: {"spawn": ()}),
        // The events: an object with the component "event". Its area is the
        // component "area" at the position of the object.
        // `SavePoint` is a command of the save module (crates/gameplay):
        // the file is written when this event ends.
        (
            name: "switch",
            pose: (position: (2.2, 0.0, -1.5)),
            components: {
                "area": (width: 0.6, depth: 0.6),
                "event": (
                    pages: [
                        (
                            trigger: Interact,
                            commands: [
                                PlaySound("sounds/click.wav", 1.0),
                                SetFlag("power_off", true),
                                LightOff("lamp_b"),
                                Message("Click. The lamp dies. Far away, a lock lets go."),
                                SavePoint,
                            ],
                        ),
                        (
                            conditions: [Flag("power_off")],
                            trigger: Interact,
                            commands: [Message("The switch does not move.")],
                        ),
                    ],
                ),
            },
        ),
        // The lamp stays off when the player comes back: the room file says "on".
        (
            name: "lamp is dead",
            components: {
                "event": (
                    pages: [
                        (conditions: [Flag("power_off")], trigger: Autorun, commands: [LightOff("lamp_b")]),
                    ],
                ),
            },
        ),
        // `ShakeCamera` is a command of the game (game/scripts/src/shake.rs): seconds, meters.
        // Not on the way of the trip script (game/scripts/src/bench.rs): a shake in its
        // frames would change the pictures that the benchmark compares.
        (
            name: "mirror ball",
            pose: (position: (-1.2, 0.0, -1.4)),
            components: {
                "area": (width: 0.8, depth: 0.8),
                "event": (
                    pages: [
                        (
                            trigger: Interact,
                            commands: [
                                ShakeCamera(0.6, 0.06),
                                Message("The ball rings. Something under the floor answers."),
                            ],
                        ),
                    ],
                ),
            },
        ),
        (
            name: "to room a",
            pose: (position: (-3.9, 0.0, 0.0)),
            components: {
                "area": (width: 0.8, depth: 1.2),
                "event": (
                    pages: [
                        (
                            trigger: Touch,
                            commands: [FadeOut(0.4), Transfer("room_a.ron", "east"), FadeIn(0.4)],
                        ),
                    ],
                ),
            },
        ),
    ],
)
