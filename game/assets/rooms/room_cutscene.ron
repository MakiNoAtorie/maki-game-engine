// Room cutscene: test room of the timeline (stage 64). Walk right into the area:
// the game goes to the state Cutscene, the timeline of the area plays to its end,
// then the player has the control again. The timeline: a camera object takes the
// view and moves, the figure walks and waves, the hall light fades. The candle on
// the table, the tube over the start, and the warning lamp on the right wall are
// the three light presets (prefabs): they flicker or pulse by themselves.
// Lengths are meters, angles degrees, times seconds.
(
    width: 8.0,
    depth: 8.0,
    height: 3.0,
    next_id: 11,
    objects: [
        // The first light of the room does not animate.
        (
            id: 1,
            name: "ceiling",
            pose: (position: (0.0, 2.6, 0.5)),
            components: {"light": (radius: 0.15, color: (1.0, 0.9, 0.8), intensity: 10.0)},
        ),
        (
            id: 2,
            name: "table",
            pose: (position: (1.0, 0.3, -1.8)),
            components: {"prop": (mesh: Cube(0.6), look: (color: (0.45, 0.3, 0.2)))},
        ),
        (
            id: 3,
            name: "candle",
            pose: (position: (1.0, 0.75, -1.8)),
            components: {"prefab": (file: "prefabs/candle.prefab")},
        ),
        (
            id: 4,
            name: "hall light",
            pose: (position: (-2.5, 2.4, -2.5)),
            components: {"light": (radius: 0.15, color: (0.8, 0.9, 1.0), intensity: 8.0)},
        ),
        (
            id: 5,
            name: "figure",
            pose: (position: (2.5, 0.0, -2.0)),
            components: {
                "animator": (clip: "models/figure.glb#hop"),
                "prop": (mesh: File("models/figure.glb")),
            },
        ),
        // The view of the cutscene: +Z of the object looks at the figure.
        (
            id: 6,
            name: "shot",
            pose: (position: (3.0, 1.6, 3.0), rotation: (9.0, -153.0, 0.0)),
            components: {"camera": (fov: 50.0, active: false)},
        ),
        (id: 7, name: "start", pose: (position: (-2.5, 0.0, 2.5)), components: {"spawn": ()}),
        (
            id: 9,
            name: "tube",
            pose: (position: (-2.5, 2.8, 2.0)),
            components: {"prefab": (file: "prefabs/fluorescent.prefab")},
        ),
        (
            id: 10,
            name: "warning",
            pose: (position: (3.8, 2.0, 0.0)),
            components: {"prefab": (file: "prefabs/warning_lamp.prefab")},
        ),
        // The area and its timeline: the camera takes the view at 0 s and moves to
        // the left; the figure walks for 3 s, then waves; the hall light fades out
        // from 3 s to 5 s; the camera gives the view back at 6 s.
        (
            id: 8,
            name: "cutscene",
            pose: (position: (-0.5, 0.0, 2.5)),
            components: {
                "area": (width: 1.0, depth: 1.4),
                "event": (
                    pages: [
                        (
                            trigger: Touch,
                            commands: [SetPlayState(Cutscene), PlayTimeline(0, true), SetPlayState(Play)],
                        ),
                    ],
                ),
                "timeline": (
                    tracks: [
                        (
                            object: 6,
                            track: (
                                channel: Field(component: "camera", field: "active"),
                                keys: [(time: 0.0, value: Switch(true)), (time: 6.0, value: Switch(false))],
                            ),
                        ),
                        (
                            object: 6,
                            track: (
                                channel: Position,
                                keys: [
                                    (time: 0.0, value: Vector((0.0, 0.0, 0.0))),
                                    (time: 5.0, value: Vector((-1.5, 0.0, 0.0))),
                                ],
                            ),
                        ),
                        (
                            object: 5,
                            track: (
                                channel: Position,
                                keys: [
                                    (time: 0.0, value: Vector((0.0, 0.0, 0.0))),
                                    (time: 3.0, value: Vector((-2.0, 0.0, 1.5))),
                                ],
                            ),
                        ),
                        (
                            object: 5,
                            track: (
                                channel: Field(component: "animator", field: "clip"),
                                keys: [
                                    (time: 0.0, value: Text("models/figure.glb#hop")),
                                    (time: 3.0, value: Text("models/figure.glb#wave")),
                                ],
                            ),
                        ),
                        (
                            object: 4,
                            track: (
                                channel: Field(component: "light", field: "intensity"),
                                keys: [(time: 3.0, value: Number(8.0)), (time: 5.0, value: Number(0.5))],
                            ),
                        ),
                    ],
                ),
            },
        ),
    ],
)
